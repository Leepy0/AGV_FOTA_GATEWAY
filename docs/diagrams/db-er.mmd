erDiagram
  firmware ||--o{ jobs : "firmware_id"
  jobs ||--|{ job_targets : "job_id (CASCADE)"
  agv_groups |o--o| agv_last_seen : "agv"
  agv_last_seen |o--o| agv_positions : "agv"
  firmware {
    text id PK
    text kind "Dsp | Esp"
    text version
    text file_name
    int size
    text sha256
    text uploaded_at
  }
  jobs {
    text id PK
    text name
    text firmware_id
    text state "Scheduled | Running | AwaitingApproval | Done | Failed | Cancelled"
    text scheduled_at
    int stop_on_failure
    text apply_mode "Approve | Immediate (v2)"
    text not_after "마감 시각 (v2)"
    text approved_at "적용 승인 시각 (v2)"
    int recover "복구 적용 0 · 1 (v3)"
  }
  job_targets {
    text job_id PK
    int agv PK
    text state "Waiting | Running | Staged | Done | Failed | Skipped"
    int percent
    text version_before
    text version_after
    text log
    int stage_job "스테이징 작업 번호 (v2)"
  }
  agv_groups {
    int agv PK
    text product_family
    text floor
    text line
    text process
    text route
    text source "acs | manual | import"
  }
  agv_positions {
    int agv PK
    real x
    real y
    real heading
    text state
  }
  agv_last_seen {
    int agv PK
    text last_seen
    text fw
    text dsp
    text status_json
  }

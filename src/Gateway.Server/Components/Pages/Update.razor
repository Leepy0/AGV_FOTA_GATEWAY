@page "/update"
@using Gateway.Core.Update
@inject UpdateService Upd
@inject AcsRelayService Acs
@inject AgvRegistry Reg
@inject IOptions<GatewayOptions> GwOpt
@inject IJSRuntime JS
@inject AppSettingsEditorService SettingsEditor
@implements IDisposable

<PageTitle>서버 업데이트 · AGV FOTA</PageTitle>
<h1>서버 업데이트</h1>

<section class="card">
    <div class="form">
        <div>현재 <b>v@(Upd.CurrentText)</b> · @Upd.ChannelName@(Upd.Commit is null ? "" : $" · {Upd.Commit}") · 마지막 확인 @(Upd.LastCheck?.ToLocalTime().ToString("MM-dd HH:mm") ?? "-")</div>
        <div class="muted small">확인 주소 @Upd.ManifestUrl</div>
        @if (Upd.OutsideScmWarning is { } scm) { <div class="msg err">@scm</div> }
        @if (!Upd.Enabled) { <div class="msg err">appsettings.json 의 Update.Enabled 가 false 입니다</div> }
        @if (!Upd.CanSelfUpdate) { <div class="muted">@(Upd.Channel == "local" ? "로컬 빌드는 자동 교체하지 않습니다 (확인·받기는 됩니다)." : "자동 교체는 Windows 서비스/콘솔 실행에서만 됩니다.")</div> }
        <div class="state-line @Upd.Stage.ToString().ToLower()">@Upd.Message</div>
        @if (Upd.Latest is { } l && (Upd.Stage is UpdateStage.Available or UpdateStage.Ready or UpdateStage.Downloading or UpdateStage.Applying || Upd.CanDownload))
        {
            <div class="muted">@l.Tag · @l.AssetName · @(l.Published == DateTimeOffset.MinValue ? "" : l.Published.ToLocalTime().ToString("yyyy-MM-dd")) · <a href="@l.PageUrl" target="_blank">릴리스 페이지</a></div>
            @if (!string.IsNullOrWhiteSpace(l.Notes)) { <pre class="log">@l.Notes</pre> }
        }
        <div class="row-buttons">
            <button @onclick="Check" disabled="@busy">지금 확인</button>
            <button @onclick="Download" disabled="@(busy || !Upd.CanDownload)">받기@(Upd.Latest is { } nl && Upd.CanDownload ? $" ({nl.Tag})" : "")</button>
            <button class="primary" @onclick="Apply" disabled="@(busy || Upd.Stage != UpdateStage.Ready || Upd.StagedTag is null || !Upd.CanSelfUpdate)">@(Upd.StagedTag is { } st ? $"{st} 적용 (서비스 재시작)" : "적용 (서비스 재시작)")</button>
            @if (Upd.OldVersionText is { } old) { <button style="color: var(--bad); border-color: var(--bad)" @onclick="Rollback" disabled="@(busy || !Upd.CanSelfUpdate || Upd.Stage is UpdateStage.Applying or UpdateStage.Checking or UpdateStage.Downloading)">이전 버전(@old)으로 되돌리기</button> }
            <a class="muted" href="@Upd.DownloadUrl" target="_blank">브라우저로 받기 (항상 최신)</a>
        </div>
        <p class="muted">적용하면 서비스가 멈추고 현재 exe 는 .old 로 남긴 채 새 파일로 바뀐 뒤 다시 시작됩니다(약 10초). 그동안 ACS 중계, 호기(브리지) UDP 수신, ACS 위치 보고가 모두 멈춥니다. 새 버전이 @(SelfUpdateScript.HealthTimeoutSec)초 안에 응답하지 않으면 이전 버전으로 자동 되돌립니다. 배포 작업이 실행 중이면 적용되지 않고, 적용을 누른 뒤에는 새 배포 작업이 시작되지 않습니다. appsettings.json 과 data 폴더는 유지됩니다.</p>
    </div>
</section>

<section class="card">
    <h2>서버 ZIP 직접 업로드</h2>
    <p class="muted small">GitHub 릴리스 없이 Windows x64 서버 배포 ZIP을 직접 올릴 수 있습니다. 파일은 64 MB 이하, 실행 파일의 제품 버전은 현재 버전보다 높아야 합니다. 업로드 후 기존 적용 버튼으로 적용하며, 정상 기동 확인 및 롤백 절차는 동일합니다. 업로드에는 관리자 토큰이 필요합니다.</p>
    @if (!SettingsEditor.IsEditTokenConfigured) { <div class="msg err">직접 업로드가 잠겨 있습니다. 서버 환경변수 <code>AGV_GATEWAY_SETTINGS_TOKEN</code> 또는 <code>Gateway:SettingsEditToken</code>을 설정하세요.</div> }
    <div class="row-buttons">
        <input type="password" placeholder="관리자 토큰" @bind="uploadToken" autocomplete="off" />
        <button @onclick="AuthorizeUpload" disabled="@(!SettingsEditor.IsEditTokenConfigured)">권한 확인</button>
        @if (uploadAuthorized) { <span class="muted">쓰기 권한 확인됨</span> }
    </div>
    <div class="form">
        <InputFile OnChange="SelectUpload" accept=".zip,application/zip" disabled="@busy" />
        @if (uploadFile is not null) { <div class="muted small">선택: @uploadFile.Name (@(uploadFile.Size / 1024) KB)</div> }
        <div class="row-buttons">
            <button @onclick="Upload" disabled="@(busy || uploadFile is null || !Upd.CanSelfUpdate || !uploadAuthorized)">업로드 및 검증</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(uploadMessage)) { <div class="msg @(uploadError ? "err" : "")" role="status">@uploadMessage</div> }
    </div>
</section>

<section class="card">
    <h2>기록</h2>
    <pre class="log">@string.Join("\n", Upd.Log.Reverse())</pre>
</section>

@code {
    bool busy;
    protected override void OnInitialized() => Upd.Changed += OnChanged;
    void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Upd.Changed -= OnChanged;
    void AuthorizeUpload() { uploadAuthorized = SettingsEditor.ValidateEditToken(uploadToken); uploadMessage = uploadAuthorized ? "쓰기 권한을 확인했습니다." : "관리자 토큰이 올바르지 않습니다."; uploadError = !uploadAuthorized; }\n    void SelectUpload(InputFileChangeEventArgs e) { uploadFile = e.File; uploadMessage = ""; uploadError = false; }\n    async Task Upload()\n    {\n        if (uploadFile is null) return;\n        if (!SettingsEditor.ValidateEditToken(uploadToken)) { uploadAuthorized = false; uploadMessage = "관리자 토큰이 올바르지 않습니다."; uploadError = true; return; }\n        busy = true; uploadMessage = ""; uploadError = false;\n        try { await using var stream = uploadFile.OpenReadStream(64L * 1024 * 1024); await Upd.StageUploadedAsync(stream, uploadFile.Name, uploadFile.Size); uploadMessage = Upd.Message; uploadFile = null; }\n        catch (Exception e) { uploadMessage = e.Message; uploadError = true; }\n        finally { busy = false; }\n    }\n    async Task Check() { busy = true; try { await Upd.CheckAsync(); } finally { busy = false; } }
    async Task Download() { busy = true; try { await Upd.DownloadAsync(); } finally { busy = false; } }
    async Task Apply()
    {
        if (!await JS.ConfirmAsync($"{Upd.StagedTag} 을(를) 적용합니다.\n\n{Impact()}\n\n새 버전이 {SelfUpdateScript.HealthTimeoutSec}초 안에 응답하지 않으면 이전 버전으로 자동 되돌립니다. 진행할까요?")) return;
        busy = true; try { await Upd.ApplyAsync(); } finally { busy = false; }
    }
    async Task Rollback()
    {
        if (Upd.OldVersionText is not { } old) return;
        if (!await JS.ConfirmAsync($"현재 v{Upd.CurrentText} 을(를) 이전 버전 {old} 로 되돌립니다. 되돌린 뒤 v{Upd.CurrentText} 로 다시 가려면 새로 받아야 합니다.\n\n{Impact()}\n\n진행할까요?")) return;
        busy = true; try { await Upd.RollbackAsync(); } finally { busy = false; }
    }
    /// <summary>재시작 동안 끊기는 것 (확인창 문구)</summary>
    string Impact()
    {
        var online = Reg.Snapshot().Count(a => a.Online(GwOpt.Value.OfflineAfterSec));
        var acs = !Acs.Enabled ? "사용 안 함" : Acs.Connected ? "연결됨 — 교통제어 프레임 중계가 끊김" : "연결 안 됨";
        return $"서비스가 약 10초 멈춥니다. 그동안 ACS 중계({acs})와 온라인 호기 {online}대의 통신(UDP 수신·ACS 위치 보고)이 끊깁니다.";
    }
}

@page "/trace"
@inject TraceLog Log
@inject BridgeUdpService Link
@inject AgvRegistry Reg
@inject IOptions<GatewayOptions> Opt
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>통신 로그 · AGV FOTA</PageTitle>
<h1>통신 로그</h1>
<p class="muted small"><code>MAIN&gt;</code> 호기→서버 · <code>MAIN&lt;</code> 서버→호기 · <code>DSP</code> 메인보드 OTA · <code>CFG</code> 설정 · <code>RFID</code> 태그 · <code>ACS-API</code> 위치 발행 · 최근 300줄</p>

<div class="form row">
    <div class="m3-field w-sm"><input  @bind="agvFilter" @bind:event="oninput" @bind:after="Apply" placeholder="예: 7" /><label>호기 필터</label></div>
    <div class="m3-field w-md"><input  @bind="text" @bind:event="oninput" @bind:after="Apply" placeholder="MAIN> · DSP · 문자열" /><label>검색</label></div>
    <label><input type="checkbox" @bind="paused" @bind:after="PausedChanged" /> 멈춤</label>
    <button @onclick="Clear">지우기</button>
    <span class="muted small">@shown.Length / @lines.Length 줄</span>
</div>
<pre class="log tall">@string.Join("\n", shown)</pre>

<section class="card">
    <h2>수동 전송</h2>
    <div class="form row">
        <div class="m3-field w-sm"><input  @bind="agv" @bind:event="oninput" placeholder="번호" /><label>호기</label></div>
        <div class="m3-field w-lg"><input class="mono" @bind="data" placeholder="W1107C001000 00000 또는 <STX>…<ETX> 전체" /><label>프레임</label></div>
        <button @onclick="Send">@(AgvLabel)MAIN_DOWN 전송</button>
        <div class="m3-field w-lg"><input class="mono" @bind="cfg" placeholder="cfg | stat | set ip 192.168.10.107 | save | reboot" /><label>설정 명령</label></div>
        <button @onclick="SendCfg" disabled="@(!int.TryParse(agv, out _))">@(AgvLabel)CFG_CMD 전송</button>
        @if (msg is not null) { <span class="msg @(err ? "err" : "")">@msg</span> }
    </div>
    <details class="more"><summary>입력 방법</summary><p class="small"><code>종류·PAN·MSG·호기2자리·본문</code> 만 적으면 STX·BCC·ETX 는 자동으로 붙습니다. <code>&lt;STX&gt;</code> 로 시작하면 그대로 전송. W/N 프레임과 설정 변경 명령은 확인창을 거치며, F·R 프레임은 보낼 수 없습니다 (배포 작업 사용).</p></details>
</section>

@code {
    [SupplyParameterFromQuery] public string? Agv { get; set; }

    string[] lines = [], shown = [];
    // 호기 칸은 비워 두고 시작 (쿼리 ?agv= 로 왔을 때만 채움) — 엉뚱한 호기로 보내지 않게
    string agv = "", data = "", cfg = "", agvFilter = "", text = "";
    string? msg;
    bool paused, err;
    // 확인 없이 보내도 되는 읽기 전용 설정 명령
    static readonly string[] ReadOnlyCfg = ["cfg", "stat", "help", "setup", "dsp", "dsp ver"];

    string AgvLabel => int.TryParse(agv, out var a) && a is >= 1 and <= 99 ? $"{a:D2} 호기에 " : "";

    protected override void OnInitialized()
    {
        Log.Changed += OnChanged;
        if (!string.IsNullOrEmpty(Agv)) { agvFilter = Agv; agv = Agv; }
        Reload();
    }
    protected override void OnParametersSet() => Apply();
    void Reload() { lines = Log.Snapshot(); Apply(); }
    void Apply()
    {
        IEnumerable<string> q = lines;
        if (int.TryParse(agvFilter, out var a) && a is >= 0 and <= 99) { var tag = $"[{a:D2}]"; q = q.Where(l => l.Contains(tag)); }
        if (!string.IsNullOrWhiteSpace(text)) q = q.Where(l => l.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase));
        shown = q.ToArray();
    }
    // 멈춤을 풀면 그사이 쌓인 줄을 바로 가져온다
    void PausedChanged() { if (!paused) Reload(); }
    void OnChanged() { if (!paused) InvokeAsync(() => { Reload(); StateHasChanged(); }); }
    public void Dispose() => Log.Changed -= OnChanged;
    void Clear() { Log.Clear(); Reload(); }

    /// <summary>수동 전송 대상 호기 확인 — 번호 범위, 번호 충돌. 거부 사유 또는 null</summary>
    string? Refusal(int a)
    {
        if (a is < 1 or > 99) return "호기 번호는 1~99";
        if (Reg.Get(a) is { } s && s.InConflict(Opt.Value.OfflineAfterSec))
            return $"{a:D2} 호기 번호를 쓰는 장치가 둘입니다 ({s.EndPoint} / {s.ConflictEndPoint}) — 충돌이 풀릴 때까지 수동 전송을 하지 않습니다";
        return null;
    }

    async Task Send()
    {
        err = false; msg = null;
        bool hasField = int.TryParse(agv, out var a);
        if (agv.Trim().Length > 0 && !hasField) { msg = "호기 번호 오류"; err = true; return; }
        var s = data.Trim();
        if (s.Length == 0) { msg = "프레임을 입력하세요"; err = true; return; }
        byte[] frame;
        char type;
        if (s.StartsWith("<STX>", StringComparison.OrdinalIgnoreCase) || s.StartsWith("\\x02"))
        {
            if (!hasField) { msg = "원문(<STX>…) 전송은 호기 칸에 번호를 넣어야 합니다"; err = true; return; }
            frame = AgvFrame.ParseData(s);
            type = frame.Length > 1 ? (char)frame[1] : '?';
        }
        else
        {
            // 종류·PAN·MSG·호기(2)·본문 → 프레임 조립 (끝 공백·BCC 자동)
            if (s.Length < 5 || !char.IsAsciiDigit(s[3]) || !char.IsAsciiDigit(s[4])) { msg = "형식: 종류 PAN MSG 호기2자리 본문 (예: W1107C001000 00000)"; err = true; return; }
            var fa = (s[3] - '0') * 10 + (s[4] - '0');
            if (hasField && fa != a) { msg = $"프레임 안의 호기({fa:D2})와 호기 칸({a:D2})이 다릅니다 — 맞춘 뒤 보내세요"; err = true; return; }
            frame = AgvFrame.Build(s[0], s[1], s[2], fa, System.Text.Encoding.ASCII.GetBytes(s[5..].TrimEnd()));
            a = fa;
            type = s[0];
        }
        if (Refusal(a) is { } no) { msg = no; err = true; return; }
        // 결정 12 확장: 메인보드 업데이트 진입(F)·응답(R) 프레임은 배포 작업만 쓴다 (REST 수동 전송과 같은 규칙)
        if (ApiGuard.IsBlockedManualFrame(frame)) { msg = ApiGuard.BlockedManualFrameMessage; err = true; return; }
        if (frame.Length > AgvFrame.BridgeFrameMax) { msg = $"프레임이 {AgvFrame.BridgeFrameMax}바이트를 넘습니다"; err = true; return; }
        if (char.ToUpperInvariant(type) is 'W' or 'N'
            && !await Confirm($"{a:D2} 호기에 {type} 프레임 전송\n{AgvFrame.Fmt(frame)}\n⚠ AGV 가 움직이거나 멈출 수 있습니다", "전송")) return;
        msg = Link.SendMainDown(a, frame) ? $"{a:D2} 전송: {AgvFrame.Fmt(frame)}" : $"실패 (호기 {a:D2} 주소 없음 — heartbeat 를 받은 적이 있어야 합니다)";
        err = !msg.Contains("전송:");
    }

    async Task SendCfg()
    {
        err = false; msg = null;
        if (!int.TryParse(agv, out var a)) { msg = "호기 번호를 넣으세요"; err = true; return; }
        var cmd = cfg.Trim();
        if (cmd.Length == 0) { msg = "명령을 입력하세요"; err = true; return; }
        // REST(/api/agvs/{n}/cfg)와 같은 길이 검사 — 넘으면 패킷을 만들 수 없다
        if (ApiGuard.CfgCommandProblem(cmd) is { } tooLong) { msg = tooLong; err = true; return; }
        if (Refusal(a) is { } no) { msg = no; err = true; return; }
        var norm = string.Join(' ', cmd.Split(' ', StringSplitOptions.RemoveEmptyEntries)).ToLowerInvariant();
        if (!ReadOnlyCfg.Contains(norm)
            && !await Confirm($"{a:D2} 호기 설정 명령 전송\n명령: {cmd}\n⚠ 설정·저장·재부팅은 그 호기 통신에 영향을 줍니다", "전송")) return;
        msg = Link.SendCfg(a, cmd) ? $"{a:D2} 전송: {cmd}" : $"실패 (호기 {a:D2} 주소 없음)";
        err = !msg.Contains("전송:");
    }

    // 확인창을 오래 열어 둬도(현장 확인) 화면 오류가 되지 않게 공통 도우미로 — 시간 초과·연결 끊김은 '취소'
    Task<bool> Confirm(string text, string ok) => JS.ConfirmAsync(text, ok, "취소", danger: true);
}

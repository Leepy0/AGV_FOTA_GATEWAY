@page "/jobs"
@inject JobService JobSvc
@inject FirmwareStore Store
@inject AgvRegistry Reg
@inject AgvGroupStore Groups
@inject IOptions<GatewayOptions> Opt
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>배포 작업 · AGV FOTA</PageTitle>
<h1>배포 작업</h1>

@{ var awaiting = JobSvc.AwaitingJob(); }
@if (awaiting is not null)
{
    <div class="banner warn big"><b>승인 대기</b> '@awaiting.Name' · @awaiting.StagedCount 대@(awaiting.ApprovedAt is null ? " — AGV 정지 확인 후 [적용 시작]" : " — 곧 적용 시작")</div>
}
@{ var unsaved = JobSvc.UnsavedCount; }
@if (unsaved > 0)
{
    <div class="banner warn" role="alert">⚠ <b>DB 저장 대기 @unsaved 건</b> — 이대로 서버가 재시작되면 최근 변경이 사라질 수 있습니다</div>
}

<div class="stack @(awaiting is not null || JobSvc.List().Any(x => x.State == JobState.Running) ? "active-first" : "")">
<section class="card">
    <h2>새 작업</h2>
    @if (Store.List().Count == 0)
    {
        <div class="empty">등록된 펌웨어가 없습니다. <a href="firmware">펌웨어</a> 에서 먼저 올리세요.</div>
    }
    else
    {
        var all = ParseTargets(extraTargets, out var parseErr);
        all.UnionWith(targets);
        <div class="form">
            <ol class="steps" aria-label="작업 만들기 단계">
                <li class="@StepCls(1)" aria-current="@(step == 1 ? "step" : null)">1. 펌웨어</li>
                <li class="@StepCls(2)" aria-current="@(step == 2 ? "step" : null)">2. 대상 호기</li>
                <li class="@StepCls(3)" aria-current="@(step == 3 ? "step" : null)">3. 방식·시각</li>
            </ol>
            @if (step == 1)
            {
            <div class="m3-field"><select @bind="fwId">
                    <option value="">선택</option>
                    @foreach (var f in Store.List()) { <option value="@f.Id">[@(f.Kind == FirmwareKind.Dsp ? "메인보드 DSP" : "브리지 ESP")] @f.Version — @f.Project (@f.UploadedAt.ToLocalTime().ToString("MM-dd HH:mm"))</option> }
                </select><label>펌웨어</label></div>
            <div class="m3-field"><input @bind="name" placeholder="비우면 펌웨어 이름" /><label>작업 이름</label></div>
            <div class="wizard-nav"><span></span><button type="button" class="primary" disabled="@(Fw is null)" @onclick="() => step = 2">다음: 대상 호기</button></div>
            }
            @if (step == 2)
            {
            @* 대상 블록은 label 로 감싸지 않는다 — 빈 곳을 누르면 안쪽 첫 버튼('온라인 전체 선택')이 눌리기 때문 *@
            <div class="field">
                <span class="field-label">대상 호기</span>
                @if (Groups.Count > 0)
                {
                    <div class="cascade">
                        @for (int i = 0; i < AgvGroup.Levels; i++)
                        {
                            var lv = i;
                            var opts = CascadeOptions(lv);
                            <select value="@casc[lv]" @onchange="e => SetCascade(lv, e.Value?.ToString() ?? string.Empty)" disabled="@(opts.Count == 0)">
                                <option value="">@AgvGroup.LevelNames[lv] 전체</option>
                                @foreach (var o in opts) { <option value="@o">@o</option> }
                            </select>
                        }
                        <button type="button" @onclick="AddCascade" disabled="@(CascadeAgvs.Count == 0)">@(CascadePath.Length == 0 ? "소속 등록된 호기" : CascadePath) 추가 (@CascadeAgvs.Count 대)</button>
                        <a href="groups" class="small">구역 관리</a>
                    </div>
                }
                <div class="row-buttons small">
                    <button type="button" @onclick="SelectOnline" title="번호 충돌 호기는 빼고 선택">온라인 전체 선택</button>
                    <button type="button" @onclick="SelectNeedUpdate" disabled="@(Fw is null)" title="선택한 펌웨어와 버전이 다른 온라인 호기만 (미지원·번호 충돌 제외)">업데이트 필요한 호기 선택</button>
                    <button type="button" @onclick="() => targets.Clear()">선택 해제</button>
                    <b class="count">@targets.Count 대 선택</b>
                </div>
                <div class="chips">
                    @foreach (var id in AllAgvIds())
                    {
                        var a = Reg.Get(id);
                        var info = Classify(id);
                        var cur = a is null ? "" : CurrentVersion(a);
                        var grp = Groups.Get(id)?.Group.Path;
                        <label class="chip @(targets.Contains(id) ? "on" : "") @(info.On ? "" : "off") @(info.Same ? "same" : "") @(info.Unsupported || info.Conflict ? "bad" : "")"
                               title="@((grp is null ? "" : grp + " · ") + ChipTitle(a, info))">
                            <input type="checkbox" checked="@targets.Contains(id)" @onchange="e => Toggle(id, (bool)e.Value!)" /> @id.ToString("D2")
                            <small>@(info.Conflict ? "충돌" : cur.Length > 0 ? cur : a is null ? "미접속" : info.On ? "?" : "off")</small>
                        </label>
                    }
                </div>
                <div class="m3-field"><input @bind="extraTargets" @bind:event="oninput" placeholder="7, 12-15 (아직 안 보이는 호기)" /><label>직접 입력</label></div>
                @if (parseErr is not null) { <div class="msg err">@parseErr</div> }
                @{ var conflicted = all.Where(id => Reg.Get(id)?.InConflict(Opt.Value.OfflineAfterSec) == true).OrderBy(x => x).ToList(); }
                @if (conflicted.Count > 0)
                {
                    <div class="msg warn" role="alert">⚠ <b>번호 충돌 @conflicted.Count 대</b> (@string.Join(", ", conflicted.Take(10).Select(x => x.ToString("D2")))@(conflicted.Count > 10 ? " …" : "")) — 배포 불가 <button type="button" class="small" @onclick="() => DropConflicted(conflicted)">선택에서 빼기</button></div>
                }
            </div>
            <div class="wizard-nav">
                <button type="button" @onclick="() => step = 1">이전</button>
                <button type="button" class="primary" disabled="@(all.Count == 0 || parseErr is not null)" @onclick="() => step = 3">다음: 방식·시각 (@all.Count 대)</button>
            </div>
            }
            @if (step == 3)
            {
            <div class="kpis">
                <div class="kpi"><div class="v">@(Fw?.Version ?? "-")</div><div class="l">@(Fw?.Kind == FirmwareKind.Dsp ? "메인보드 DSP" : "브리지 ESP")</div></div>
                <div class="kpi"><div class="v">@all.Count 대</div><div class="l">@string.Join(", ", all.OrderBy(x => x).Take(10).Select(x => x.ToString("D2")))@(all.Count > 10 ? " …" : "")</div></div>
            </div>
            @if (Fw?.Kind == FirmwareKind.Dsp)
            {
                <div class="m3-field"><select @bind="applyMode">
                        <option value="@ApplyMode.Approve">받아 두고 → 승인 후 적용 (권장)</option>
                        <option value="@ApplyMode.Immediate">받는 즉시 적용 (야간 예약용)</option>
                    </select><label>적용 방식</label></div>
                <p class="hint">@(applyMode == ApplyMode.Approve ? "받기는 주행 중에도 OK · 굽기는 정지 확인 후 [적용 시작]" : "시작 시각에 모든 AGV 가 정지해 있어야 합니다")</p>
                <div class="field">
                    <label class="inline" title="@RecoverText"><input type="checkbox" @bind="recover" /> 복구 적용 <span class="muted small">(멈춘 앱용)</span></label>
                    @{ var unknown = all.Where(id => Classify(id).Unknown).OrderBy(x => x).ToList(); }
                    @if (unknown.Count > 0 && !recover)
                    {
                        <div class="msg warn">⚠ <b>앱 버전 모름 @unknown.Count 대</b> (@string.Join(", ", unknown.Take(10).Select(x => x.ToString("D2")))@(unknown.Count > 10 ? " …" : "")) — 앱이 멈춘 호기라면 [복구 적용]</div>
                    }
                </div>
            }
            <div class="field-row">
                <div class="m3-field w-md" title="시작을 @(JobService.StaleScheduleMinutes)분 넘게 못 하면 자동 취소 · 앞 작업이 있으면 끝난 뒤 시작">
                    <select @bind="when">
                        <option value="now">지금 바로</option>
                        <option value="at">예약</option>
                    </select><label>실행 시각</label>
                </div>
                @if (when == "at") { <div class="m3-field w-md"><input type="datetime-local" step="60" @bind="at" @bind:format="@DtFormat" /><label>예약 시각</label></div> }
            </div>
            <div class="field-row">
                <label class="inline" title="이 시각이 지나면 남은 호기는 건너뜀"><input type="checkbox" @bind="useNotAfter" /> 마감 시각</label>
                @if (useNotAfter) { <div class="m3-field w-md"><input type="datetime-local" step="60" @bind="notAfter" @bind:format="@DtFormat" /><label>마감</label></div> }
            </div>
            <label><input type="checkbox" @bind="stopOnFailure" /> 한 대라도 실패하면 나머지 중단</label>
            <div class="banner warn big">⚠ <b>AGV 정지 상태에서만</b> 적용 — 굽는 동안 ACS 응답이 끊깁니다</div>
            <div class="wizard-nav">
                <button type="button" @onclick="() => step = 2">이전</button>
                <button class="primary" @onclick="Create" disabled="@(busy || string.IsNullOrEmpty(fwId) || all.Count == 0 || parseErr is not null)">@(when == "at" ? "예약" : "지금 시작")@(all.Count > 0 ? $" ({all.Count}대)" : "")</button>
            </div>
            }
            @if (msg is not null) { <div class="msg @(err ? "err" : warn ? "warn" : "")">@msg</div> }
        </div>
    }
</section>

<section class="card">
    @{ var list = JobSvc.List(); }
    <h2>작업 목록 <span class="muted small">@list.Count</span></h2>
    @if (listMsg is not null) { <div class="msg err">@listMsg</div> }
    @if (list.Count == 0) { <div class="empty">아직 작업이 없습니다.</div> }
    @foreach (var j in list.Take(shown))
    {
        var isOpen = OpenId(list) == j.Id;
        <div class="job @j.State.ToString().ToLower()">
            <div class="job-head" tabindex="0" role="button" aria-expanded="@(isOpen ? "true" : "false")" aria-label="@($"{j.Name} 대상 {j.Targets.Count}대 {State(j)} — {(isOpen ? "접기" : "펼치기")}")"
                 @onclick="() => ToggleOpen(isOpen, j.Id)" @onkeydown="e => HeadKey(e, isOpen, j.Id)">
                <span class="state">@State(j)</span>
                <b class="jname">@j.Name</b>
                <span class="jcount"><b>@j.DoneCount</b> / @j.Targets.Count 완료</span>
                @if (j.FailCount > 0) { <span class="badge bad">실패 @j.FailCount</span> }
                @if (j.StagedCount > 0) { <span class="badge warn">스테이징 @j.StagedCount</span> }
                <span class="muted small @(IsLate(j) ? "warn-text" : "")">@(j.Kind == FirmwareKind.Dsp ? "메인보드" : "브리지") @j.FirmwareVersion@(j.Recover ? " · 복구" : "") · @When(j, list)</span>
                @if (j.State is JobState.Running or JobState.AwaitingApproval) { <span class="bar wide"><span style="width:@(Progress(j))%"></span></span> }
                <span class="actions">
                    @* 머리 안 버튼: 클릭·Enter 가 머리(펼치기)로 번지지 않게 *@
                    @if (j.State == JobState.AwaitingApproval && j.ApprovedAt is null) { <button class="primary" @onclick:stopPropagation @onkeydown:stopPropagation @onclick="() => Approve(j)">적용 시작</button> }
                    @if (j.IsActive) { <button @onclick:stopPropagation @onkeydown:stopPropagation @onclick="() => Cancel(j)">취소</button> }
                    else { <button @onclick:stopPropagation @onkeydown:stopPropagation @onclick="() => Delete(j)">삭제</button> }
                </span>
            </div>
            @if (isOpen)
            {
                <div class="table-wrap">
                <table class="grid clickable">
                    <thead><tr><th>호기</th><th>상태</th><th>진행</th><th>이전 → 이후</th><th>사유</th><th>시간</th></tr></thead>
                    <tbody>
                        @foreach (var r in j.Results)
                        {
                            var key = j.Id + ":" + r.Agv;
                            var showLog = r.Log.Count > 0 && (r.State is TargetState.Running or TargetState.Failed || logOpen.Contains(key));
                            <tr class="t-@r.State.ToString().ToLower()" @onclick="() => ToggleLog(key)" title="누르면 로그 표시">
                                <td><b>@r.Agv.ToString("D2")</b></td>
                                <td>@TState(r.State)</td>
                                <td><div class="bar"><div style="width:@(r.Percent)%"></div></div> @r.Percent%</td>
                                <td>@r.VersionBefore → @r.VersionAfter</td>
                                <td class="small wrap">@(r.State is TargetState.Failed or TargetState.Skipped ? r.Message : "")</td>
                                <td class="small">@r.StartedAt?.ToLocalTime().ToString("HH:mm:ss") ~ @r.FinishedAt?.ToLocalTime().ToString("HH:mm:ss")@Dur(r)</td>
                            </tr>
                            @if (showLog)
                            {
                                <tr><td colspan="6"><pre class="log">@string.Join("\n", logOpen.Contains(key) ? r.Log : r.Log.TakeLast(12))</pre></td></tr>
                            }
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>
    }
    @if (list.Count > shown) { <button @onclick="() => shown += 20">더 보기 (@(list.Count - shown)건 더)</button> }
</section>

</div>

@code {
    [SupplyParameterFromQuery] public int? Agv { get; set; }
    [SupplyParameterFromQuery] public string? Group { get; set; }
    /// <summary>펌웨어 화면·호기 현황의 "배포 작업 만들기"에서 넘어올 때: 미리 고를 펌웨어 id, 호기 목록(쉼표)</summary>
    [SupplyParameterFromQuery(Name = "fw")] public string? FwQuery { get; set; }
    [SupplyParameterFromQuery(Name = "agvs")] public string? AgvsQuery { get; set; }
    readonly string[] casc = new string[AgvGroup.Levels];

    int step = 1;   // 새 작업 단계: 1 펌웨어 · 2 대상 호기 · 3 방식·시각
    string StepCls(int n) => n == step ? "cur" : n < step ? "done" : "";
    string fwId = "", name = "", extraTargets = "", when = "now";
    // Blazor 는 datetime-local 값을 초까지 붙여 보낸다("…T22:30" → "…T22:30:00") — 분까지만 읽는 형식이면 해석에 실패해 바꾼 값이 기본값으로 되돌아간다
    const string DtFormat = "yyyy-MM-ddTHH:mm:ss";
    static DateTime ToMinute(DateTime d) => new(d.Year, d.Month, d.Day, d.Hour, d.Minute, 0, d.Kind);
    DateTime at = ToMinute(DateTime.Now.AddMinutes(10)), notAfter = ToMinute(DateTime.Now.AddHours(2));
    ApplyMode applyMode = ApplyMode.Approve;
    bool stopOnFailure = true, useNotAfter, recover, err, warn, busy;
    string? msg, listMsg, open;   // open: null = 실행 중·적용 대기 작업 자동, "" = 모두 접음
    int shown = 20;
    readonly HashSet<int> targets = new();
    readonly HashSet<string> logOpen = new();

    FirmwareEntry? Fw => string.IsNullOrEmpty(fwId) ? null : Store.Get(fwId);
    const string RecoverText = "앱이 멈춘·지워진 메인보드용 — 전원 재투입을 최대 60초 기다립니다 (그동안 RFID·ACS 끊김)";
    string? OpenId(IReadOnlyList<Job> list) => open ?? list.FirstOrDefault(j => j.State is JobState.Running or JobState.AwaitingApproval)?.Id;

    protected override void OnInitialized()
    {
        JobSvc.Changed += OnChanged; Reg.Changed += OnChanged; Groups.Changed += OnChanged;
        if (Agv is int a && a is >= 1 and <= 99) targets.Add(a);
        if (!string.IsNullOrEmpty(FwQuery) && Store.Get(FwQuery) is not null) fwId = FwQuery;
        foreach (var s in (AgvsQuery ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            if (int.TryParse(s, out var q) && q is >= 1 and <= 99) targets.Add(q);
        for (int i = 0; i < AgvGroup.Levels; i++) casc[i] = "";
        if (Group is not null)
        {
            // 구역 화면에서 "이 호기들에 배포" 로 넘어온 경우: 경로를 단계별 선택에 채우고 그 아래 호기를 모두 대상에
            var parts = Group.Split(" / ");
            for (int i = 0; i < parts.Length && i < AgvGroup.Levels; i++) casc[i] = parts[i];
            foreach (var id in Groups.AgvsUnder(Group)) targets.Add(id);
            if (Group.Length > 0 && targets.Count > 0) name = $"{Group} 전체";
        }
        at = ToMinute(DateTime.Now.AddMinutes(10));
        notAfter = ToMinute(DateTime.Now.AddHours(2));
        // 펌웨어·구역 화면에서 미리 채워 넘어온 경우 이미 끝난 단계는 건너뛴다
        if (Fw is not null) step = targets.Count > 0 ? 3 : 2;
    }

    IEnumerable<int> AllAgvIds() => Reg.Snapshot().Select(a => a.Id).Union(Groups.Snapshot().Select(g => g.Agv)).OrderBy(x => x);
    string CascadePath { get { int d = 0; while (d < AgvGroup.Levels && casc[d].Length > 0) d++; return string.Join(" / ", casc.Take(d)); } }
    IReadOnlyList<int> CascadeAgvs => Groups.AgvsUnder(CascadePath);
    List<string> CascadeOptions(int lv)
    {
        if (lv > 0 && casc[lv - 1].Length == 0) return new();
        var node = GroupTree.Find(Groups.Tree, string.Join(" / ", casc.Take(lv)));
        return node?.Children.Select(c => c.Name).ToList() ?? new();
    }
    void SetCascade(int lv, string v) { casc[lv] = v; for (int i = lv + 1; i < AgvGroup.Levels; i++) casc[i] = ""; }
    void AddCascade() { foreach (var id in CascadeAgvs) targets.Add(id); if (string.IsNullOrWhiteSpace(name) && CascadePath.Length > 0) name = $"{CascadePath} 전체"; }
    void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() { JobSvc.Changed -= OnChanged; Reg.Changed -= OnChanged; Groups.Changed -= OnChanged; }
    void Toggle(int id, bool on) { if (on) targets.Add(id); else targets.Remove(id); }
    void ToggleOpen(bool isOpen, string id) => open = isOpen ? "" : id;
    // 작업 머리를 키보드로 펼치기 (Tab 으로 옮겨 Enter)
    void HeadKey(KeyboardEventArgs e, bool isOpen, string id) { if (e.Key == "Enter") ToggleOpen(isOpen, id); }
    void DropConflicted(IEnumerable<int> ids)
    {
        foreach (var id in ids) targets.Remove(id);
        // 직접 입력에 적은 충돌 호기는 칸을 고쳐야 빠지므로 남은 번호로 다시 적는다
        var rest = ParseTargets(extraTargets, out var e);
        if (e is null) extraTargets = string.Join(", ", rest.Except(ids).OrderBy(x => x));
    }
    void ToggleLog(string key) { if (!logOpen.Remove(key)) logOpen.Add(key); }
    // 번호 충돌 호기는 작업에서 거부되므로 고르지 않는다 (결정 2A)
    void SelectOnline() { foreach (var a in Reg.Snapshot().Where(a => a.Online(Opt.Value.OfflineAfterSec) && !a.InConflict(Opt.Value.OfflineAfterSec))) targets.Add(a.Id); }
    void SelectNeedUpdate()
    {
        if (Fw is null) return;
        targets.Clear();
        foreach (var a in Reg.Snapshot())
        {
            var c = Classify(a.Id);
            if (c.On && !c.Same && !c.Unsupported && !c.Conflict) targets.Add(a.Id);
        }
    }
    string CurrentVersion(AgvState a) => Fw?.Kind == FirmwareKind.Dsp ? (a.Status is { } s && s.HasDsp ? s.Dsp : "") : a.Status?.Fw ?? "";

    /// <summary>호기 하나의 배포 관점 상태 (칩·확인창 요약 공통)</summary>
    /// <summary>Unknown = 메인보드 앱 버전 모름 (dsp=?: 구 앱·앱 멈춤·브리지 재부팅 직후)</summary>
    record struct AgvInfo(bool On, bool Unsupported, bool Same, bool Conflict, bool Unknown);
    AgvInfo Classify(int id)
    {
        var a = Reg.Get(id);
        var off = Opt.Value.OfflineAfterSec;
        var on = a?.Online(off) == true;
        var dsp = Fw?.Kind == FirmwareKind.Dsp;
        var unsupported = dsp && on && (string.IsNullOrEmpty(a?.Status?.DspState) || a?.Status?.DspState == "nopart");
        var cur = a is null ? "" : CurrentVersion(a);
        var same = Fw is not null && cur.Length > 0 && (dsp ? DspVersion.Matches(cur, Fw.Version) : cur == Fw.Version);
        var conflict = a?.InConflict(off) == true;
        var unknown = dsp && on && !unsupported && a?.Status is { HasDsp: false };
        return new AgvInfo(on, unsupported, same, conflict, unknown);
    }
    string ChipTitle(AgvState? a, AgvInfo i) =>
        i.Conflict ? "호기 번호 충돌 — 같은 번호의 장치가 둘 (배포 거부)"
        : i.Unsupported ? (a?.Status?.DspState == "nopart" ? "브리지에 dspfw 파티션 없음 (USB 전체 굽기 필요)" : "브리지 fw 가 메인보드 OTA 를 지원하지 않음 (0.5.0 이상 필요)")
        : i.Same ? "이미 이 버전"
        : i.Unknown ? "앱 버전 모름 — 앱이 멈춘 호기면 복구 적용으로 (살아 있는 구 앱은 업데이트 진입 미지원)"
        : a is null ? "아직 heartbeat 없음 (ACS·구역 등록만 됨)"
        : i.On ? "" : "오프라인 — 시작 때 20초 안에 heartbeat 가 없으면 실패";

    /// <summary>직접 입력 "7, 12-15" → 호기 번호. 형식이 틀리면 error</summary>
    static HashSet<int> ParseTargets(string text, out string? error)
    {
        var all = new HashSet<int>();
        error = null;
        foreach (var tok in text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var r = tok.Split('-');
            if (r.Length == 2 && int.TryParse(r[0], out var a) && int.TryParse(r[1], out var b) && a <= b && b - a < 100) for (int i = a; i <= b; i++) all.Add(i);
            else if (int.TryParse(tok, out var v)) all.Add(v);
            else { error = $"호기 표기 오류: {tok}"; continue; }
        }
        if (error is null && all.Any(x => x < 1 || x > 99)) error = "호기 번호는 1~99";
        return all;
    }

    static string State(Job j) => j.State switch
    {
        JobState.Scheduled => "대기", JobState.Running => "실행 중", JobState.AwaitingApproval => j.ApprovedAt is null ? "적용 대기" : "적용 승인됨",
        JobState.Done => "완료", JobState.Failed => "실패", JobState.Cancelled => "취소", _ => "?"
    };
    static string TState(TargetState s) => s switch
    {
        TargetState.Waiting => "대기", TargetState.Running => "진행 중", TargetState.Staged => "스테이징됨", TargetState.Done => "완료",
        TargetState.Failed => "실패", TargetState.Skipped => "건너뜀", _ => "?"
    };
    static int Progress(Job j) => j.Targets.Count == 0 ? 0 : (int)j.Results.Sum(r => r.State == TargetState.Done ? 100 : r.State is TargetState.Running or TargetState.Staged ? r.Percent : 0) / j.Targets.Count;
    static string Dur(TargetResult r) => r.StartedAt is { } s && r.FinishedAt is { } f ? $" ({(int)(f - s).TotalSeconds}초)" : "";
    static bool IsLate(Job j) => j.State == JobState.Scheduled && j.ScheduledAt is { } sa && sa < DateTime.UtcNow.AddMinutes(-1);
    static string Local(DateTime utc) => utc.ToLocalTime().ToString("MM-dd HH:mm");
    static string Deadline(Job j) => j.NotAfter is { } na ? $" · 마감 {Local(na)}" : "";

    string When(Job j, IReadOnlyList<Job> list)
    {
        var ahead = list.FirstOrDefault(x => x.Id != j.Id && x.State is JobState.Running or JobState.AwaitingApproval);
        if (j.State == JobState.Scheduled && j.ScheduledAt is { } sa)
        {
            var left = sa - DateTime.UtcNow;
            var rel = left < TimeSpan.Zero ? $"{(int)-left.TotalMinutes}분 지남" : left.TotalMinutes < 1 ? "곧" : left.TotalHours < 1 ? $"{(int)left.TotalMinutes}분 후" : $"{(int)left.TotalHours}시간 {left.Minutes}분 후";
            return $"예약 {Local(sa)} ({rel}){(ahead is null ? "" : " · 앞 작업 대기")}{Deadline(j)}";
        }
        if (j.State == JobState.Scheduled) return (ahead is null ? "곧 시작" : $"앞 작업 '{ahead.Name}' 대기") + Deadline(j);
        if (j.State == JobState.AwaitingApproval) return (j.ApprovedAt is { } ap ? $"승인 {Local(ap)}" : "정지 확인 후 적용") + Deadline(j);
        var t = j.FinishedAt ?? j.StartedAt ?? j.CreatedAt;
        return $"{(j.FinishedAt is not null ? "종료" : j.StartedAt is not null ? "시작" : "생성")} {Local(t)}{Deadline(j)}";
    }

    async Task Approve(Job j)
    {
        listMsg = null;
        if (j.NotAfter is { } na && na <= DateTime.UtcNow.AddMinutes(1))
        {
            listMsg = $"'{j.Name}' 의 마감 시각({Local(na)})이 지났거나 1분 안에 지납니다 — 적용할 수 없습니다. 작업을 취소하고 다시 만드세요.";
            return;
        }
        var staged = j.Results.Where(r => r.State == TargetState.Staged).ToList();
        var unknown = staged.Count(r => Reg.Get(r.Agv)?.Status is { HasDsp: false });
        var conflict = staged.Count(r => Reg.Get(r.Agv)?.InConflict(Opt.Value.OfflineAfterSec) == true);
        var offline = staged.Count(r => Reg.Get(r.Agv)?.Online(Opt.Value.OfflineAfterSec) != true);
        var probs = string.Join(" · ", new[] { offline > 0 ? $"오프라인 {offline}" : "", conflict > 0 ? $"번호 충돌 {conflict}" : "", !j.Recover && unknown > 0 ? $"앱 버전 모름 {unknown}" : "" }.Where(x => x.Length > 0));
        var q = $"'{j.Name}' 적용 시작 · {staged.Count}대\n호기: {string.Join(", ", staged.Take(12).Select(r => r.Agv.ToString("D2")))}{(staged.Count > 12 ? " …" : "")}"
              + "\n⚠ 모든 AGV 정지 확인 — 호기당 20~30초 ACS 응답이 끊깁니다"
              + (probs.Length > 0 ? $"\n⚠ {probs}" : "")
              + (j.Recover ? "\n⚠ 복구 적용 — 전원 재투입을 최대 60초 기다립니다" : "")
              + (j.NotAfter is { } na2 ? $"\n마감 {Local(na2)} ({(int)(na2 - DateTime.UtcNow).TotalMinutes}분 남음)" : "");
        if (!await JS.ConfirmAsync(q, "적용 시작", "취소", danger: true)) return;
        try { JobSvc.Approve(j.Id); open = j.Id; }
        catch (InvalidOperationException ex) { listMsg = ex.Message; }
    }

    async Task Cancel(Job j)
    {
        listMsg = null;
        var dsp = j.Kind == FirmwareKind.Dsp;
        string q;
        if (j.State == JobState.Running)
        {
            var r = j.Results.FirstOrDefault(x => x.State == TargetState.Running);
            q = r is null ? $"'{j.Name}' 취소\n남은 호기는 건너뜁니다"
              : r.Committed
                ? $"'{j.Name}' 취소\n⚠ {r.Agv:D2}호기는 이미 {(dsp ? "굽는" : "받는")} 중 — 끝까지 진행됩니다 ({(dsp ? "약 30초" : "받은 뒤 재부팅")})\n남은 호기만 건너뜁니다"
                : $"'{j.Name}' 취소\n{r.Agv:D2}호기는 지금 멈추고, 남은 호기는 건너뜁니다";
        }
        else if (j.State == JobState.AwaitingApproval)
            q = $"'{j.Name}' 취소\n스테이징된 {j.StagedCount}대에는 적용하지 않습니다";
        else q = $"'{j.Name}' 예약 취소";
        // 이 작업이 끝나면 밀려 있던 대기 작업이 1~2초 안에 바로 시작된다 — 몇 건인지 같은 확인창에 보인다
        IReadOnlyList<Job> queued = j.State is JobState.Running or JobState.AwaitingApproval ? JobSvc.QueuedDue(j.Id) : [];
        if (queued.Count > 0) q += $"\n⚠ 대기 작업 {queued.Count}건('{queued[0].Name}'{(queued.Count > 1 ? " 등" : "")})이 이어서 시작됩니다 — 다음 창에서 선택";
        if (!await JS.ConfirmAsync(q, "작업 취소", "계속 진행", danger: true)) return;
        bool alsoQueued = false;
        if (queued.Count > 0)
        {
            // 창을 닫거나 응답이 없으면(시간 초과·연결 끊김) false — 그때는 아무것도 바로 시작되지 않는 쪽(함께 취소)으로
            queued = JobSvc.QueuedDue(j.Id);
            if (queued.Count > 0)
                alsoQueued = !await JS.ConfirmAsync(
                    $"대기 작업 {queued.Count}건이 바로 시작됩니다\n'{queued[0].Name}'{(queued.Count > 1 ? " 등" : "")}", "이 작업만 취소", "대기 작업도 함께 취소");
        }
        if (!JobSvc.Cancel(j.Id, alsoQueued)) listMsg = "이미 끝난 작업입니다";
        else if (JobSvc.UnsavedCount > 0) listMsg = "취소는 반영됐지만 DB 저장이 밀려 있습니다 — 다시 시도 중 (위 'DB 저장 대기' 참고)";
    }

    async Task Delete(Job j)
    {
        if (await JS.ConfirmAsync($"'{j.Name}' 기록을 삭제할까요?", "기록 삭제", danger: true)) JobSvc.Delete(j.Id);
    }

    async Task Create()
    {
        if (busy) return;   // 빠른 두 번 클릭
        msg = null; err = warn = false; busy = true;
        try
        {
            var fw = Fw ?? throw new InvalidOperationException("펌웨어를 선택하세요");
            var all = ParseTargets(extraTargets, out var parseErr);
            if (parseErr is not null) throw new InvalidOperationException(parseErr);
            all.UnionWith(targets);
            if (all.Count == 0) throw new InvalidOperationException("대상 호기를 선택하세요");
            if (when == "at" && at <= DateTime.Now) throw new InvalidOperationException("예약 시각이 이미 지났습니다");
            if (useNotAfter && notAfter <= (when == "at" ? at : DateTime.Now)) throw new InvalidOperationException("마감 시각은 시작 시각보다 뒤여야 합니다");

            var dsp = fw.Kind == FirmwareKind.Dsp;
            var mode = dsp ? applyMode : ApplyMode.Immediate;
            var rec = dsp && recover;
            var info = all.Select(Classify).ToList();
            var list = JobSvc.List();
            var ahead = list.FirstOrDefault(x => x.State is JobState.Running or JobState.AwaitingApproval) ?? JobSvc.QueuedDue().FirstOrDefault();
            var unknown = info.Count(i => i.Unknown);
            var probs = string.Join(" · ", new[] { info.Count(i => !i.On) is > 0 and var off ? $"오프라인 {off}" : "", info.Count(i => i.Unsupported) is > 0 and var uns ? $"미지원 {uns}" : "", info.Count(i => i.Same) is > 0 and var same ? $"같은 버전 {same}" : "", info.Count(i => i.Conflict) is > 0 and var cf ? $"번호 충돌 {cf}" : "", dsp && !rec && unknown > 0 ? $"앱 버전 모름 {unknown}" : "" }.Where(x => x.Length > 0));
            var q = $"[{(dsp ? "메인보드 DSP" : "브리지 ESP")}] {fw.Version} 배포 · {all.Count}대{(rec ? " · 복구" : "")}\n"
                  + $"호기: {string.Join(", ", all.OrderBy(x => x).Take(12).Select(x => x.ToString("D2")))}{(all.Count > 12 ? " …" : "")}\n"
                  + $"시작: {(when == "at" ? at.ToString("MM-dd HH:mm") : "지금")}{(ahead is not null && when != "at" ? $" (앞 작업 '{ahead.Name}' 뒤)" : "")}{(useNotAfter ? $" · 마감 {notAfter:MM-dd HH:mm}" : "")}\n"
                  + $"방식: {(!dsp ? "받은 뒤 재부팅" : mode == ApplyMode.Approve ? "스테이징 → 승인 후 굽기" : "받는 즉시 굽기")}"
                  + (probs.Length > 0 ? $"\n⚠ {probs}" : "")
                  + (dsp && mode == ApplyMode.Approve ? "" : "\n⚠ 모든 AGV 정지 확인");
            if (!await JS.ConfirmAsync(q, when == "at" ? "예약" : "지금 시작")) return;

            var j = JobSvc.Create(name, fw.Id, all, when == "at" ? at.ToUniversalTime() : null, stopOnFailure, mode, useNotAfter ? notAfter.ToUniversalTime() : null, rec);
            if (when == "at") msg = $"예약: {j.Name} ({j.Targets.Count}대, {at:MM-dd HH:mm})";
            else if (ahead is not null) { msg = $"대기: 앞 작업 '{ahead.Name}' 뒤에 시작 ({j.Targets.Count}대)"; warn = true; }
            else msg = $"시작: {j.Name} ({j.Targets.Count}대){(j.NeedsApproval ? " — 받기가 끝나면 [적용 시작]" : "")}";
            // 같은 작업을 또 만들지 않도록 선택을 비운다
            targets.Clear(); extraTargets = ""; name = ""; fwId = ""; useNotAfter = false; recover = false; open = null; step = 1;
        }
        catch (Exception ex) { msg = ex.Message; err = true; }
        finally { busy = false; }
    }
}

@page "/jobs"
@inject JobService JobSvc
@inject FirmwareStore Store
@inject AgvRegistry Reg
@inject IOptions<GatewayOptions> Opt
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>배포 작업 · AGV FOTA</PageTitle>
<h1>배포 작업</h1>

<section class="card">
    <h2>새 작업</h2>
    @if (Store.List().Count == 0)
    {
        <div class="empty">등록된 펌웨어가 없습니다. <a href="firmware">펌웨어</a> 에서 먼저 올리세요.</div>
    }
    else
    {
        <div class="form">
            <label>펌웨어
                <select @bind="fwId">
                    <option value="">선택</option>
                    @foreach (var f in Store.List()) { <option value="@f.Id">[@(f.Kind == FirmwareKind.Dsp ? "메인보드 DSP" : "브리지 ESP")] @f.Version — @f.Project (@f.UploadedAt.ToLocalTime().ToString("MM-dd HH:mm"))</option> }
                </select>
            </label>
            <label>작업 이름 <input @bind="name" placeholder="비우면 펌웨어 이름" /></label>
            <label>대상 호기
                <div class="row-buttons small">
                    <button type="button" @onclick="SelectOnline">온라인 전체 선택</button>
                    <button type="button" @onclick="SelectNeedUpdate" disabled="@(Fw is null)" title="선택한 펌웨어와 버전이 다른 온라인 호기만">업데이트 필요한 호기 선택</button>
                    <button type="button" @onclick="() => targets.Clear()">선택 해제</button>
                    <span class="muted">@targets.Count 대 선택@(Fw is null ? "" : $" · 칩의 작은 글씨 = 현재 {(Fw.Kind == FirmwareKind.Dsp ? "메인보드" : "브리지")} 버전")</span>
                </div>
                <div class="chips">
                    @foreach (var a in Reg.Snapshot())
                    {
                        var on = a.Online(Opt.Value.OfflineAfterSec);
                        var cur = CurrentVersion(a);
                        var same = Fw is not null && cur == Fw.Version;
                        var unsupported = Fw?.Kind == FirmwareKind.Dsp && on && string.IsNullOrEmpty(a.Status?.DspState);
                        <label class="chip @(targets.Contains(a.Id) ? "on" : "") @(on ? "" : "off") @(same ? "same" : "") @(unsupported ? "bad" : "")"
                               title="@(unsupported ? "브리지 fw 가 메인보드 OTA 를 지원하지 않음 (0.5.0 이상 필요)" : same ? "이미 이 버전" : on ? "" : "오프라인 — 실행 시각에 heartbeat 가 없으면 실패")">
                            <input type="checkbox" checked="@targets.Contains(a.Id)" @onchange="e => Toggle(a.Id, (bool)e.Value!)" /> @a.Id.ToString("D2")
                            <small>@(cur.Length > 0 ? cur : on ? "?" : "off")</small>
                        </label>
                    }
                </div>
                <input @bind="extraTargets" placeholder="직접 입력: 7, 12-15 (아직 안 보이는 호기)" />
            </label>
            <label>실행 시각
                <select @bind="when">
                    <option value="now">지금 바로</option>
                    <option value="at">예약</option>
                </select>
                @if (when == "at") { <input type="datetime-local" @bind="at" @bind:format="yyyy-MM-ddTHH:mm" /> <span class="muted small">서버가 꺼져 있다가 @(JobService.StaleScheduleMinutes)분 넘게 지나서 켜지면 자동 취소됩니다</span> }
            </label>
            <label><input type="checkbox" @bind="stopOnFailure" /> 한 대라도 실패하면 나머지 중단</label>
            <p class="muted">호기는 한 대씩 순차로 진행됩니다. <b>AGV 정지 상태</b>에서만 실행하세요 (메인보드는 굽는 20~30초 동안 ACS 응답이 끊기고, 브리지는 재부팅으로 수 초간 끊깁니다).</p>
            <button class="primary" @onclick="Create" disabled="@(busy || string.IsNullOrEmpty(fwId))">@(when == "at" ? "예약" : "지금 시작")@(targets.Count > 0 ? $" ({targets.Count}대)" : "")</button>
            @if (msg is not null) { <div class="msg @(err ? "err" : "")">@msg</div> }
        </div>
    }
</section>

<section class="card">
    <h2>작업 목록 <span class="muted small">@JobSvc.List().Count 건</span></h2>
    @if (JobSvc.List().Count == 0) { <div class="empty">아직 작업이 없습니다.</div> }
    @foreach (var j in JobSvc.List().Take(shown))
    {
        var isOpen = OpenId == j.Id;
        <div class="job @j.State.ToString().ToLower()">
            <div class="job-head" @onclick="() => ToggleOpen(isOpen, j.Id)">
                <span class="state">@State(j)</span>
                <b>@j.Name</b>
                <span class="muted">@(j.Kind == FirmwareKind.Dsp ? "메인보드" : "브리지") @j.FirmwareVersion · 대상 @j.Targets.Count 대 · 완료 @j.DoneCount / 실패 @j.FailCount</span>
                <span class="muted">@When(j)</span>
                @if (j.State == JobState.Running) { <span class="bar wide"><span style="width:@(Progress(j))%"></span></span> }
                <span class="actions">
                    @if (j.State is JobState.Scheduled or JobState.Running) { <button @onclick:stopPropagation @onclick="() => Cancel(j)">취소</button> }
                    else { <button @onclick:stopPropagation @onclick="() => Delete(j)">삭제</button> }
                </span>
            </div>
            @if (isOpen)
            {
                <div class="table-wrap">
                <table class="grid clickable">
                    <thead><tr><th>호기</th><th>상태</th><th>진행</th><th>이전 → 이후</th><th>메시지</th><th>시간</th></tr></thead>
                    <tbody>
                        @foreach (var r in j.Results)
                        {
                            var key = j.Id + ":" + r.Agv;
                            var showLog = r.Log.Count > 0 && (r.State is TargetState.Running or TargetState.Failed || logOpen.Contains(key));
                            <tr class="t-@r.State.ToString().ToLower()" @onclick="() => ToggleLog(key)" title="누르면 로그 표시">
                                <td><b>@r.Agv.ToString("D2")</b></td>
                                <td>@TState(r.State)</td>
                                <td><div class="bar"><div style="width:@(r.Percent)%"></div></div> @r.Percent%</td>
                                <td>@r.VersionBefore → @r.VersionAfter</td>
                                <td class="small wrap">@r.Message</td>
                                <td class="small">@r.StartedAt?.ToLocalTime().ToString("HH:mm:ss") ~ @r.FinishedAt?.ToLocalTime().ToString("HH:mm:ss")@Dur(r)</td>
                            </tr>
                            @if (showLog)
                            {
                                <tr><td colspan="6"><pre class="log">@string.Join("\n", logOpen.Contains(key) ? r.Log : r.Log.TakeLast(12))</pre></td></tr>
                            }
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>
    }
    @if (JobSvc.List().Count > shown) { <button @onclick="() => shown += 20">더 보기 (@(JobSvc.List().Count - shown)건 더)</button> }
</section>

@code {
    [SupplyParameterFromQuery] public int? Agv { get; set; }

    string fwId = "", name = "", extraTargets = "", when = "now";
    DateTime at = DateTime.Now.AddMinutes(10);
    bool stopOnFailure = true, err, busy;
    string? msg, open;   // open: null = 실행 중인 작업 자동, "" = 모두 접음
    int shown = 20;
    readonly HashSet<int> targets = new();
    readonly HashSet<string> logOpen = new();

    FirmwareEntry? Fw => string.IsNullOrEmpty(fwId) ? null : Store.Get(fwId);
    string? OpenId => open ?? JobSvc.List().FirstOrDefault(j => j.State == JobState.Running)?.Id;

    protected override void OnInitialized()
    {
        JobSvc.Changed += OnChanged; Reg.Changed += OnChanged;
        if (Agv is int a && a is >= 1 and <= 99) targets.Add(a);
        at = DateTime.Now.AddMinutes(10);
    }
    void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() { JobSvc.Changed -= OnChanged; Reg.Changed -= OnChanged; }
    void Toggle(int id, bool on) { if (on) targets.Add(id); else targets.Remove(id); }
    void ToggleOpen(bool isOpen, string id) => open = isOpen ? "" : id;
    void ToggleLog(string key) { if (!logOpen.Remove(key)) logOpen.Add(key); }
    void SelectOnline() { foreach (var a in Reg.Snapshot().Where(a => a.Online(Opt.Value.OfflineAfterSec))) targets.Add(a.Id); }
    void SelectNeedUpdate()
    {
        if (Fw is null) return;
        targets.Clear();
        foreach (var a in Reg.Snapshot().Where(a => a.Online(Opt.Value.OfflineAfterSec) && CurrentVersion(a) != Fw.Version))
            if (Fw.Kind == FirmwareKind.Esp || !string.IsNullOrEmpty(a.Status?.DspState)) targets.Add(a.Id);
    }
    string CurrentVersion(AgvState a) => Fw?.Kind == FirmwareKind.Dsp ? (a.Status is { } s && s.HasDsp ? s.Dsp : "") : a.Status?.Fw ?? "";

    static string State(Job j) => j.State switch
    {
        JobState.Scheduled => "대기", JobState.Running => "실행 중", JobState.Done => "완료", JobState.Failed => "실패", JobState.Cancelled => "취소", _ => "?"
    };
    static string TState(TargetState s) => s switch
    {
        TargetState.Waiting => "대기", TargetState.Running => "진행 중", TargetState.Done => "완료", TargetState.Failed => "실패", TargetState.Skipped => "건너뜀", _ => "?"
    };
    static int Progress(Job j) => j.Targets.Count == 0 ? 0 : (int)j.Results.Sum(r => r.State == TargetState.Done ? 100 : r.State == TargetState.Running ? r.Percent : 0) / j.Targets.Count;
    static string Dur(TargetResult r) => r.StartedAt is { } s && r.FinishedAt is { } f ? $" ({(int)(f - s).TotalSeconds}초)" : "";
    static string When(Job j)
    {
        if (j.State == JobState.Scheduled && j.ScheduledAt is { } sa)
        {
            var left = sa - DateTime.UtcNow;
            return $"예약 {sa.ToLocalTime():MM-dd HH:mm} ({(left.TotalMinutes < 1 ? "곧" : left.TotalHours < 1 ? $"{(int)left.TotalMinutes}분 후" : $"{(int)left.TotalHours}시간 {left.Minutes}분 후")})";
        }
        var t = j.FinishedAt ?? j.StartedAt ?? j.CreatedAt;
        return $"{(j.ScheduledAt is null ? "즉시" : "예약 " + j.ScheduledAt.Value.ToLocalTime().ToString("MM-dd HH:mm"))} · {(j.FinishedAt is not null ? "종료" : j.StartedAt is not null ? "시작" : "생성")} {t.ToLocalTime():MM-dd HH:mm}";
    }

    async Task Cancel(Job j)
    {
        var q = j.State == JobState.Running ? $"'{j.Name}' 실행을 중단할까요? 진행 중인 호기는 실패로 기록됩니다." : $"'{j.Name}' 예약을 취소할까요?";
        if (await JS.InvokeAsync<bool>("confirm", q)) JobSvc.Cancel(j.Id);
    }
    async Task Delete(Job j)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"'{j.Name}' 기록을 삭제할까요?")) JobSvc.Delete(j.Id);
    }

    void Create()
    {
        msg = null; err = false; busy = true;
        try
        {
            var all = new HashSet<int>(targets);
            foreach (var tok in extraTargets.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                var r = tok.Split('-');
                if (r.Length == 2 && int.TryParse(r[0], out var a) && int.TryParse(r[1], out var b) && a <= b && b - a < 100) for (int i = a; i <= b; i++) all.Add(i);
                else if (int.TryParse(tok, out var v)) all.Add(v);
                else throw new InvalidOperationException($"호기 표기 오류: {tok}");
            }
            if (all.Count == 0) throw new InvalidOperationException("대상 호기를 선택하세요");
            if (all.Any(x => x < 1 || x > 99)) throw new InvalidOperationException("호기 번호는 1~99");
            if (when == "at" && at <= DateTime.Now) throw new InvalidOperationException("예약 시각이 이미 지났습니다");
            var j = JobSvc.Create(name, fwId, all, when == "at" ? at.ToUniversalTime() : null, stopOnFailure);
            msg = when == "at" ? $"예약: {j.Name} ({j.Targets.Count}대, {at:MM-dd HH:mm})" : $"시작: {j.Name} ({j.Targets.Count}대)";
            targets.Clear(); extraTargets = ""; name = ""; open = null;
        }
        catch (Exception ex) { msg = ex.Message; err = true; }
        finally { busy = false; }
    }
}

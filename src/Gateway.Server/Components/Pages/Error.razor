@page "/Error"
@using System.Diagnostics

<PageTitle>오류 · AGV FOTA</PageTitle>

<h1>요청을 처리하는 중 오류가 났습니다</h1>
<p class="muted">서버 로그(<code>data\logs\gateway-날짜.log</code>)에 자세한 내용이 남아 있습니다. <a href="">호기 현황으로</a></p>
@if (ShowRequestId)
{
    <p class="small muted">Request ID: <code>@RequestId</code></p>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}

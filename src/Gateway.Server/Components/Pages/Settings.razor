@page "/settings"
@using System.Net.NetworkInformation
@using System.Net.Sockets
@inject IOptions<GatewayOptions> Gw
@inject IOptions<UpdateOptions> Up
@inject IOptions<AcsApiOptions> AcsApi
@inject UpdateService Upd
@inject BridgeUdpService Link
@inject JobService Jobs
@inject FileLoggerProvider Logs
@inject AcsRelayService Acs
@inject AcsPositionPushService Push
@inject AcsInventoryPullService Inv
@inject IOptions<AcsInventoryOptions> InvOpt
@inject AgvGroupStore Groups
@inject Gateway.Server.Data.GatewayDb Db
@inject HostGuard Hosts
@inject AppSettingsEditorService SettingsEditor
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>설정 · AGV FOTA</PageTitle>
<h1>설정</h1>
<p class="muted">현재 적용된 값입니다. 아래 편집기에서 설정을 변경하고 저장하거나, 저장 후 서비스를 재시작해 반영할 수 있습니다. 서버 업데이트 시에도 기존 설정은 유지되고 새 버전의 누락된 기본 설정이 보충됩니다.</p>\n\n<section class="card">\n    <h2>설정 파일 편집</h2>\n    <p class="muted small">JSON 형식 그대로 편집합니다. 문법 오류가 있으면 저장하지 않습니다. 비밀값은 <code>********</code>로 가려지며, 그대로 두면 기존 값이 유지됩니다. 저장 전 원본 백업을 만듭니다.</p>\n    <textarea class="mono" style="width:100%; min-height:28rem; font-family:monospace" @bind="settingsJson" spellcheck="false"></textarea>\n    @if (!string.IsNullOrWhiteSpace(settingsMessage)) { <div class="msg @(settingsError ? "err" : "")" role="status">@settingsMessage</div> }\n    <div class="row-buttons">\n        <button @onclick="LoadSettings" disabled="@settingsBusy">다시 읽기</button>\n        <button @onclick="SaveSettings" disabled="@settingsBusy">설정 저장</button>\n        <button class="primary" @onclick="SaveAndApply" disabled="@settingsBusy">저장 후 반영 (서비스 재시작)</button>\n    </div>\n</section>

<section class="card">
    <h2>서버</h2>
    <dl class="kv">
        <dt>버전</dt><dd>v@(Upd.CurrentText) · @Upd.ChannelName @(Upd.Commit is null ? "" : $"({Upd.Commit})")</dd>
        <dt>실행 파일</dt><dd class="mono">@AppContext.BaseDirectory</dd>
        <dt>데이터</dt><dd class="mono">@Gw.Value.DataDir <span class="muted">(펌웨어 firmware\, DB gateway.db, 업데이트 update\, 로그 logs\)</span></dd>
        <dt>로그</dt><dd class="mono">@Logs.Directory <span class="muted">(gateway-날짜.log, @(FileLoggerProvider.KeepDays)일 보관 · 수준은 Logging:LogLevel, 파일만 따로 Logging:File:LogLevel)</span></dd>
        <dt>데이터베이스</dt><dd><span class="mono">@Db.Path</span> <span class="muted">(SQLite, @((Db.FileSize / 1024.0).ToString("N0")) KB · 펌웨어 @Db.Count("firmware") · 작업 @Db.Count("jobs") · 소속 @Db.Count("agv_groups") · 위치 @Db.Count("agv_positions") · 접속 기록 @Db.Count("agv_last_seen"))</span> <a href="api/db/backup">백업 내려받기</a></dd>
        <dt>HTTP</dt><dd>포트 @Jobs.HttpPort · 이 PC 주소: @foreach (var ip in LocalIps()) { <code>http://@ip:@Jobs.HttpPort</code> }</dd>
        <dt>브리지 UDP</dt><dd>:@Gw.Value.UdpPort (RFID :@(Gw.Value.RfidPort > 0 ? Gw.Value.RfidPort : "사용 안 함")) @(Link.BindError is null ? "" : $"⚠ {Link.BindError}")
            · ACS 로 안 보낸 상향 프레임 <span class="@(Link.AcsDroppedFrames > 0 ? "warn-text" : "")" title="ETX 없음·BCC 오류로 ACS 에 넘기지 않은 MAIN_UP 프레임 수 (UART 잡음·배선 확인)">@Link.AcsDroppedFrames</span></dd>
        <dt>오프라인 판정</dt><dd>heartbeat @(Gw.Value.OfflineAfterSec)초 없음</dd>
        <dt>OTA 파일 주소</dt><dd>@(string.IsNullOrEmpty(Gw.Value.PublicBaseUrl) ? "자동 (호기 쪽 NIC 의 IP + HTTP 포트)" : Gw.Value.PublicBaseUrl) <span class="muted">— 브리지가 펌웨어를 받아 가는 주소. NIC 이 여러 개라 잘못 잡히면 PublicBaseUrl 로 고정 (브리지에 설정된 server IP 와 같은 IPv4 로: http://IPv4:포트 — 소문자 http, 앞자리 0 없이, 경로 없이)</span>
            @if (Gw.Value.PublicBaseUrlProblem() is { } urlProblem) { <div class="msg warn" role="alert">⚠ @urlProblem</div> }</dd>
        <dt>접속 이름</dt><dd>@Hosts.Describe() <span class="muted">— 이 밖의 이름(Host)으로 화면·API 에 접속하면 403 (DNS 리바인딩 방어). 사내 DNS 별칭으로 접속하면 Gateway.AllowedHostNames 에 추가</span></dd>
        <dt>실행 환경</dt><dd>@Environment.OSVersion · .NET @Environment.Version · @(Environment.UserInteractive ? "콘솔" : "서비스") · 시작 @System.Diagnostics.Process.GetCurrentProcess().StartTime.ToString("MM-dd HH:mm")</dd>
    </dl>
</section>

<section class="card">
    <h2>ACS 중계 (TCP, 기존 ZigBee 게이트웨이 대체)</h2>
    <dl class="kv">
        <dt>상태</dt><dd>@(Acs.Enabled ? (Acs.Connected ? $"연결 ({Acs.ConnectedAt?.ToLocalTime():MM-dd HH:mm} 부터) · ACS로 {Acs.ToAcs} / ACS에서 {Acs.FromAcs}" : "끊김 — 재접속 중") : "사용 안 함 (Gateway.Acs.Enabled=false)")</dd>
        <dt>설정</dt><dd>@Gw.Value.Acs.Mode @Gw.Value.Acs.Host:@Gw.Value.Acs.Port · 재접속 @(Gw.Value.Acs.ReconnectSec)초 · 상향은 E/A 프레임만 전달</dd>
        @if (Acs.Enabled)
        {
            <dt>원격 주소</dt><dd class="mono">@(Acs.RemoteEndPoint ?? "-")</dd>
            @if (IsAcsServer)
            {
                <dt>허용 IP</dt><dd>@(AllowedText) <span class="muted">(Gateway.Acs.AllowedRemotes)</span> · 거부한 접속 <span class="@(Acs.RejectedRemotes > 0 ? "warn-text" : "")">@Acs.RejectedRemotes</span></dd>
            }
            <dt>하향 차단</dt><dd>F·R 프레임 버림 <span class="@(Acs.BlockedDown > 0 ? "warn-text" : "")">@Acs.BlockedDown</span> <span class="muted">(업데이트 진입·응답 종류는 ACS 경로로 메인보드에 넘기지 않음)</span> · 상향 적체로 버림 @Acs.Dropped</dd>
        }
    </dl>
    @if (Acs.Enabled && IsAcsServer)
    {
        <p class="muted small">Server 모드는 한 번에 한 연결만 받습니다 — 새 접속이 오면 기존 연결을 닫고 교체합니다. 다른 PC 가 접속해 ACS 연결을 빼앗지 않도록 <code>Gateway.Acs.AllowedRemotes</code> 에 ACS IP 를 넣으세요.@(AllowedText == "전체" ? " (지금은 비어 있어 모두 허용)" : "")</p>
    }
</section>

<section class="card">
    <h2>ACS 위치 보고 (REST)</h2>
    <dl class="kv">
        <dt>상태</dt><dd>@(Push.Enabled ? (Push.LogOnly ? "로그만 (LogOnly=true, 실제 전송 안 함)" : Push.FailStreak > 0 ? $"오류 연속 {Push.FailStreak}회" : "발행 중") : "사용 안 함 (AcsApi.Enabled=false)")</dd>
        <dt>대상</dt><dd class="mono">@Push.Target</dd>
        <dt>인증</dt><dd>@AcsApi.Value.AuthType @(AcsApi.Value.AuthType != "None" ? (string.IsNullOrEmpty(AcsApi.Value.AuthValue) ? "⚠ 값 없음 (AcsApi__AuthValue 환경변수 또는 appsettings)" : "값 설정됨") : "")</dd>
        <dt>주기</dt><dd>@(AcsApi.Value.IntervalMs) ms · @(AcsApi.Value.OnlyChanged ? "바뀐 호기만" : "매번 전체") · @(AcsApi.Value.PerAgv ? "호기별 요청" : "묶음 요청") · 타임아웃 @(AcsApi.Value.TimeoutMs) ms · 최대 백오프 @(AcsApi.Value.MaxBackoffSec)초</dd>
        <dt>최근</dt><dd>@(Push.LastTry is null ? "-" : $"{Push.LastTry?.ToLocalTime():HH:mm:ss} {Push.LastResult}") · 성공 @(Push.SentCount)회 · 마지막 성공 @(Push.LastOk?.ToLocalTime().ToString("HH:mm:ss") ?? "-")</dd>
    </dl>
    <p class="muted small">스키마가 정해지면 <code>Gateway.Core/Acs/AcsPositionMapper.cs</code> 와 <code>docs/ACS_API.md</code> 를 맞춥니다. 미리보기: <a href="api/acs/preview" target="_blank">/api/acs/preview</a></p>
</section>

<section class="card">
    <h2>ACS 호기 소속 받기 (REST, 제품군·층·라인·공정·라우트)</h2>
    <dl class="kv">
        <dt>상태</dt><dd>@(Inv.Enabled ? (Inv.FailStreak > 0 ? $"오류 연속 {Inv.FailStreak}회" : "받는 중") : "사용 안 함 (AcsInventory.Enabled=false) — 구역 화면에서 직접 입력·CSV")</dd>
        <dt>대상</dt><dd class="mono">@Inv.Target</dd>
        <dt>주기</dt><dd>@(InvOpt.Value.IntervalSec > 0 ? $"{InvOpt.Value.IntervalSec}초" : "시작 때 한 번") · @(InvOpt.Value.OverrideManual ? "직접 입력값도 덮어씀" : "직접 입력값 유지") · @(InvOpt.Value.RemoveMissing ? "목록에 없는 호기 삭제" : "목록에 없는 호기 유지")</dd>
        <dt>필드 매핑</dt><dd class="mono small">root=@(InvOpt.Value.Fields.Root.Length > 0 ? InvOpt.Value.Fields.Root : "(자동)") agv=@InvOpt.Value.Fields.Agv name=@InvOpt.Value.Fields.Name 제품군=@InvOpt.Value.Fields.ProductFamily 층=@InvOpt.Value.Fields.Floor 라인=@InvOpt.Value.Fields.Line 공정=@InvOpt.Value.Fields.Process 라우트=@InvOpt.Value.Fields.Route</dd>
        <dt>최근</dt><dd>@(Inv.LastTry is null ? "-" : $"{Inv.LastTry?.ToLocalTime():HH:mm:ss} {Inv.LastResult}") · 등록 @Groups.Count 대</dd>
    </dl>
    <p class="muted small">스키마가 정해지면 보통 appsettings.json 의 <code>AcsInventory.Fields</code> 만 맞추면 됩니다 (중첩 필드는 <code>a.b</code>). 구조가 많이 다르면 <code>Gateway.Core/Acs/AcsInventoryMapper.cs</code>. 구역 화면의 "응답 미리보기" 로 저장 없이 확인합니다.</p>
</section>

<section class="card">
    <h2>서버 업데이트</h2>
    <dl class="kv">
        <dt>확인 주소</dt><dd class="mono">@Upd.ManifestUrl</dd>
        <dt>주기</dt><dd>@(Up.Value.Enabled ? $"시작 {Up.Value.FirstCheckDelaySec}초 후, 이후 {(Up.Value.CheckIntervalMin > 0 ? $"{Up.Value.CheckIntervalMin}분마다" : "자동 확인 없음")}" : "사용 안 함") · @(Up.Value.AutoApply ? "자동 적용 (배포 작업 없을 때, ACS 중계 연결 중이면 화면에서 적용)" : "수동 적용")</dd>
        <dt>자체 교체</dt><dd>@(Upd.CanSelfUpdate ? "가능" : Upd.Channel == "local" ? "로컬 빌드는 교체 안 함" : "Windows 에서만")</dd>
        <dt>GitHub 토큰</dt><dd>@(string.IsNullOrEmpty(Up.Value.GitHubToken) ? "없음 (저장소가 비공개면 매니페스트 확인이 404 — 저장소 공개 전환 필요)" : "설정됨")</dd>
    </dl>
</section>

<section class="card">
    <h2>REST API</h2>
    <p class="muted small">화면과 같은 서비스를 쓰는 스크립트용 API 입니다. <code>GET /api/agvs</code> 호기 · <code>GET /api/firmware</code> · <code>POST /api/firmware</code>(multipart kind/version/notes/file) · <code>GET|POST /api/jobs</code> · <code>POST /api/jobs/{id}/approve|cancel</code> · <code>DELETE /api/jobs/{id}</code> · <code>DELETE /api/firmware/{id}</code> · <code>POST /api/agvs/{n}/send|info|cfg</code> · <code>GET /api/positions</code> · <code>GET /api/update</code> · <code>GET /api/health</code>. 변경 요청(POST·PUT·DELETE)은 다른 출처의 웹페이지에서 브라우저로 보내면 거부합니다(403). 접속 주소(Host)가 IP·localhost·이 PC 이름·Gateway.AllowedHostNames 가 아니면 모든 요청을 거부합니다(403). 잘못된 입력은 400 과 짧은 사유를 돌려줍니다. 자세한 것은 <code>docs/INTERFACES.md</code>.</p>
</section>

@code {
    System.Threading.Timer? timer;
    // ACS 중계·위치 보고·소속 받기 상태가 연 시점 값에 멈추지 않게 3초마다 다시 그린다
    protected override void OnInitialized() { settingsJson = SettingsEditor.ReadMasked(); timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 3000, 3000); }\n    void LoadSettings() { try { settingsJson = SettingsEditor.ReadMasked(); settingsMessage = "현재 파일을 다시 읽었습니다."; settingsError = false; } catch (Exception e) { settingsMessage = e.Message; settingsError = true; } }\n    void SaveSettings() { settingsBusy = true; try { SettingsEditor.Save(settingsJson); settingsJson = SettingsEditor.ReadMasked(); settingsMessage = "설정을 저장했습니다. 실행 중인 서비스에는 아직 적용되지 않았습니다."; settingsError = false; } catch (Exception e) { settingsMessage = e.Message; settingsError = true; } finally { settingsBusy = false; } }\n    async Task SaveAndApply() { if (!await JS.ConfirmAsync("설정을 저장하고 서버 서비스를 재시작합니다. 재시작 중 ACS 중계와 AGV 통신이 잠시 중단됩니다. 진행할까요?")) return; settingsBusy = true; try { SettingsEditor.Save(settingsJson); SettingsEditor.RequestRestart(); settingsMessage = "설정 저장 완료. 서비스 재시작을 요청했습니다."; settingsError = false; } catch (Exception e) { settingsMessage = e.Message; settingsError = true; settingsBusy = false; } }
    public void Dispose() => timer?.Dispose();

    static string SettingsPath => Path.Combine(AppContext.BaseDirectory, "appsettings.json");
    bool IsAcsServer => Gw.Value.Acs.Mode.Equals("Server", StringComparison.OrdinalIgnoreCase);
    string AllowedText => Gw.Value.Acs.AllowedRemotes is { } a && a.Any(x => !string.IsNullOrWhiteSpace(x)) ? string.Join(", ", a.Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x.Trim())) : "전체";
    static IEnumerable<string> LocalIps()
    {
        var list = new List<string>();
        try
        {
            foreach (var ni in NetworkInterface.GetAllNetworkInterfaces())
            {
                if (ni.OperationalStatus != OperationalStatus.Up || ni.NetworkInterfaceType == NetworkInterfaceType.Loopback) continue;
                foreach (var ua in ni.GetIPProperties().UnicastAddresses)
                    if (ua.Address.AddressFamily == AddressFamily.InterNetwork) list.Add(ua.Address.ToString());
            }
        }
        catch { }
        return list.Count > 0 ? list : ["localhost"];
    }
}

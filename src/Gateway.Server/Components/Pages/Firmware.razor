@page "/firmware"
@inject FirmwareStore Store
@inject JobService JobSvc
@inject IJSRuntime JS
@inject BridgeReleaseService Rel
@inject AgvRegistry Reg
@inject IOptions<GatewayOptions> Opt
@implements IDisposable

<PageTitle>펌웨어 · AGV FOTA</PageTitle>
<h1>펌웨어</h1>

<section class="card">
    <h2>브리지 새 버전 <span class="muted small">GitHub 릴리스 (bridge.json)</span></h2>
    @if (Rel.Latest is { } latest)
    {
        var have = Rel.AlreadyImported(latest);
        var outdated = Reg.Snapshot().Where(a => latest.IsOutdated(a.Status?.Fw)).ToList();
        <p>최신 <b>v@(latest.Version.ToString(3))</b> <span class="muted small">(@(latest.Published == DateTimeOffset.MinValue ? "" : latest.Published.ToLocalTime().ToString("yyyy-MM-dd HH:mm")) · <a href="@latest.PageUrl" target="_blank" rel="noopener">릴리스 페이지</a>)</span>
            · 구버전 <b>@outdated.Count</b>대@(outdated.Count > 0 ? $" ({string.Join(", ", outdated.Take(12).Select(a => a.Id.ToString("D2")))}{(outdated.Count > 12 ? " …" : "")})" : "")</p>
        @if (latest.Notes.Length > 0) { <p class="muted small">@latest.Notes</p> }
        <div class="row-buttons">
            @if (have is null)
            {
                <button class="primary" @onclick="ImportRelease" disabled="@relBusy">@(relBusy ? "가져오는 중…" : $"펌웨어로 가져오기 (v{latest.Version.ToString(3)})")</button>
            }
            else
            {
                <span class="msg">이미 가져옴: 아래 목록의 v@(have.Version)</span>
                var onlineOld = outdated.Where(a => a.Online(Opt.Value.OfflineAfterSec)).Select(a => a.Id).ToList();
                var jobUrl = $"jobs?fw={have.Id}" + (onlineOld.Count > 0 ? "&agvs=" + string.Join(",", onlineOld) : "");
                <a class="button" href="@jobUrl">배포 작업 만들기@(onlineOld.Count > 0 ? $" (온라인 구버전 {onlineOld.Count}대 선택됨)" : "")</a>
            }
            <button @onclick="CheckRelease" disabled="@relBusy">지금 확인</button>
        </div>
    }
    else
    {
        <p class="muted">@(Rel.Error ?? "아직 확인하지 않았습니다.")</p>
        <div class="row-buttons"><button @onclick="CheckRelease" disabled="@relBusy">지금 확인</button></div>
    }
    @if (Rel.Latest is not null && Rel.Error is not null) { <p class="msg warn">@Rel.Error</p> }
    @if (relMsg is not null) { <div class="msg @(relErr ? "err" : "")">@relMsg</div> }
    <p class="muted small">@(Rel.LastCheck == default ? "" : $"마지막 확인 {Rel.LastCheck.ToLocalTime():HH:mm:ss} · ")주소 <span class="mono">@Rel.ManifestUrl</span> — 받은 이미지는 sha256·크기·앱 헤더를 확인한 뒤에만 목록에 올립니다.</p>
</section>

<section class="card">
    <h2>업로드</h2>
    <div class="form">
        <label>종류
            <select @bind="kind" @bind:after="KindChanged">
                <option value="Dsp">메인보드 DSP (TMS320F2808, .dspfw)</option>
                <option value="Esp">브리지 ESP32-S3 (agv_wifi_bridge.bin)</option>
            </select>
        </label>
        @if (kind == "Dsp")
        {
            <p class="muted">CCS 빌드 결과를 <code>tools/dsp_pack.py</code> 로 묶은 <b>.dspfw</b> 파일을 올립니다. 버전·CRC 는 파일 헤더에서 읽습니다(버전은 8자 이하 영문·숫자·._-). 브리지 0.5.0 이상이 받아 두었다가 메인보드에 굽습니다.</p>
            <label>.dspfw 파일 <InputFile OnChange="e => file = e.File" accept=".dspfw" /></label>
        }
        else
        {
            <p class="muted">ESP-IDF <code>build/agv_wifi_bridge.bin</code> (앱 이미지만) 을 올립니다. 버전·프로젝트·빌드 시각은 이미지 안의 앱 디스크립터에서 읽어 확인합니다. bootloader·partition-table·merged 이미지는 거부됩니다.</p>
            <label>agv_wifi_bridge.bin <InputFile OnChange="e => file = e.File" accept=".bin" /></label>
        }
        @if (file is not null) { <div class="muted small">선택: @file.Name (@file.Size.ToString("N0") B)</div> }
        <label>버전 <input @bind="version" placeholder="비우면 파일에서 읽음 (입력하면 일치 확인)" /></label>
        <label>메모 <input @bind="notes" placeholder="변경 내용 등 (비우면 빌드 정보)" /></label>
        <button class="primary" @onclick="Upload" disabled="@(busy || file is null)">@(busy ? "업로드 중…" : "업로드")</button>
        @if (msg is not null) { <div class="msg @(err ? "err" : "")">@msg</div> }
        @if (warn is not null) { <div class="msg warn">@warn</div> }
    </div>
</section>

<section class="card">
    <h2>목록 <span class="muted small">@list.Count 개</span></h2>
    @if (list.Count == 0) { <div class="empty">등록된 펌웨어가 없습니다.</div> }
    else
    {
        <div class="table-wrap">
        <table class="grid">
            <thead><tr><th>종류</th><th>버전</th><th>프로젝트</th><th>파일</th><th>SHA-256</th><th>업로드</th><th>메모</th><th>사용</th><th></th></tr></thead>
            <tbody>
                @foreach (var e in list)
                {
                    var jobs = jobList.Where(j => j.FirmwareId == e.Id).ToList();
                    var active = jobs.Where(j => j.IsActive).ToList();
                    var awaitingN = active.Count(j => j.State == JobState.AwaitingApproval);
                    var dup = list.Count(x => x.Kind == e.Kind && x.Version == e.Version) > 1;
                    <tr>
                        <td>@(e.Kind == FirmwareKind.Dsp ? "메인보드" : "브리지")</td>
                        <td><b>@e.Version</b> @(dup ? "⚠" : "")</td>
                        <td>@e.Project</td>
                        <td class="small wrap">@foreach (var f in e.Files) { <a href="fw/@e.Id/@f.FileName" title="다운로드">@f.FileName</a> <span class="muted">(@f.Size.ToString("N0") B)</span> }</td>
                        <td class="mono small" title="@(e.Files.FirstOrDefault()?.Sha256)">@(e.Files.FirstOrDefault()?.Sha256[..8].ToLowerInvariant())…</td>
                        <td>@e.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="small wrap">@e.Notes</td>
                        <td class="small" title="@string.Join(", ", active.Select(j => j.Name))">@(active.Count > 0 ? $"사용 중 {active.Count}{(awaitingN > 0 ? $" (적용 대기 {awaitingN})" : "")}" : jobs.Count > 0 ? $"작업 {jobs.Count}건" : "")</td>
                        <td><button @onclick="() => Delete(e)" disabled="@(active.Count > 0)" title="@(active.Count > 0 ? "끝나지 않은 작업(대기·실행 중·적용 대기)이 쓰는 펌웨어입니다 — 작업을 먼저 취소" : "")">삭제</button></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        @if (list.GroupBy(x => (x.Kind, x.Version)).Any(g => g.Count() > 1)) { <p class="muted small">⚠ 같은 종류·버전이 여러 개 있습니다. 작업 만들 때 헷갈리지 않도록 오래된 것을 지우세요.</p> }
    }
</section>

@code {
    string kind = "Dsp", version = "", notes = "";
    IBrowserFile? file;
    bool busy, err;
    string? msg, warn;
    IReadOnlyList<FirmwareEntry> list = [];
    IReadOnlyList<Job> jobList = [];

    // 다른 PC·REST 로 올린 펌웨어, 작업 상태 변화(삭제 버튼 활성)를 바로 반영
    protected override void OnInitialized()
    {
        Store.Changed += OnChanged; JobSvc.Changed += OnChanged; Rel.Changed += OnChanged;
        Load();
    }
    void Load() { list = Store.List(); jobList = JobSvc.List(); }
    void OnChanged() => InvokeAsync(() => { Load(); StateHasChanged(); });
    public void Dispose() { Store.Changed -= OnChanged; JobSvc.Changed -= OnChanged; Rel.Changed -= OnChanged; }

    bool relBusy, relErr;
    string? relMsg;

    async Task CheckRelease()
    {
        relBusy = true; relMsg = null; relErr = false;
        try { await Rel.CheckAsync(); relMsg = Rel.Error is null ? $"최신 v{Rel.Latest?.Version.ToString(3)}" : null; }
        finally { relBusy = false; }
    }

    async Task ImportRelease()
    {
        relBusy = true; relMsg = null; relErr = false;
        try { var e = await Rel.ImportLatestAsync(); relMsg = $"가져옴: 브리지 {e.Version} — {e.FilesText}"; }
        catch (InvalidOperationException ex) { relMsg = ex.Message; relErr = true; }
        catch (Exception ex) { relMsg = "가져오기 실패: " + ex.Message; relErr = true; }
        finally { relBusy = false; Load(); }
    }

    // 이 펌웨어를 쓰는 끝나지 않은 작업 이름 (확인창 전 안내용 — 실제 판정은 DeleteFirmwareIfUnused 가 원자적으로)
    List<string> ActiveJobNames(string id) => JobSvc.List().Where(j => j.FirmwareId == id && j.IsActive).Select(j => j.Name).ToList();

    // 종류를 바꾸면 이전 InputFile 이 사라지므로 고른 파일도 비운다 (사라진 요소의 파일은 읽을 수 없음)
    void KindChanged() { file = null; msg = null; warn = null; err = false; }

    async Task Upload()
    {
        if (file is null) return;
        busy = true; msg = null; warn = null; err = false;
        var k = kind == "Dsp" ? FirmwareKind.Dsp : FirmwareKind.Esp;
        try
        {
            const long max = 64L * 1024 * 1024;
            await using var s = file.OpenReadStream(max);
            var e = await Store.AddAsync(k, version, "", notes, [(k == FirmwareKind.Dsp ? "dspfw" : "esp", file.Name, s)]);
            msg = $"등록: {(e.Kind == FirmwareKind.Dsp ? "메인보드" : "브리지")} {e.Version} — {e.FilesText}";
            var dups = Store.List().Count(x => x.Kind == e.Kind && x.Version == e.Version) - 1;
            if (dups > 0) warn = $"같은 버전 {e.Version} 이 이미 {dups}개 등록되어 있습니다 — 내용이 같다면 하나만 남기세요.";
            file = null; version = ""; notes = "";
        }
        catch (Microsoft.JSInterop.JSException) { msg = "파일을 읽지 못했습니다 — 파일을 다시 고르세요"; err = true; file = null; }
        catch (Exception ex) { msg = ex.Message; err = true; }
        finally { busy = false; Load(); }
    }

    async Task Delete(FirmwareEntry e)
    {
        msg = null; err = false;
        try
        {
            var users = ActiveJobNames(e.Id);
            if (users.Count > 0) { msg = $"작업 {string.Join(", ", users)} 이(가) 쓰는 펌웨어입니다 — 작업을 먼저 취소하세요"; err = true; return; }
            if (!await JS.ConfirmAsync($"{(e.Kind == FirmwareKind.Dsp ? "메인보드" : "브리지")} {e.Version} 을(를) 삭제할까요? 파일도 함께 지워집니다.")) return;
            // 확인창이 떠 있는 동안 작업이 생겼을 수 있다 — REST 와 같은 원자적 경로가 사용 여부를 다시 보고 지운다
            if (JobSvc.DeleteFirmwareIfUnused(e.Id, out var inUse)) msg = $"삭제: {e.Version}";
            else if (inUse.Count > 0) { msg = $"그사이 작업 {string.Join(", ", inUse.Select(j => j.Name))} 이(가) 이 펌웨어를 쓰게 되어 지우지 않았습니다"; err = true; }
            else msg = "이미 삭제된 펌웨어입니다";
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex) { msg = "삭제 실패: " + ex.Message; err = true; }
        finally { Load(); }
    }
}

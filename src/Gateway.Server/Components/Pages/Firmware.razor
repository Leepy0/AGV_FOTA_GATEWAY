@page "/firmware"
@inject FirmwareStore Store
@inject JobService JobSvc
@rendermode InteractiveServer

<h1>펌웨어</h1>

<section class="card">
    <h2>업로드</h2>
    <div class="form">
        <label>종류
            <select @bind="kind">
                <option value="Dsp">DSP (메인보드, TMS320F2808)</option>
                <option value="Esp">브리지 (ESP32-S3, agv_wifi_bridge.bin)</option>
            </select>
        </label>
        <label>버전 <input @bind="version" placeholder="예: 1.0.3" /></label>
        <label>프로젝트 <input @bind="project" placeholder="@(kind == "Dsp" ? "agv-dsp" : "agv_wifi_bridge")" /></label>
        <label>메모 <input @bind="notes" /></label>
        @if (kind == "Dsp")
        {
            <p class="muted">CCS 빌드 결과를 <code>dsp_pack.py</code> 로 묶은 <b>.dspfw</b> 파일을 올립니다. 버전은 파일 헤더에서 읽습니다(입력하면 일치 확인). 브리지 0.5.0 이상이 받아 두었다가 메인보드에 굽습니다.</p>
            <label>.dspfw <InputFile OnChange="e => fileDsp = e.File" /></label>
        }
        else
        {
            <label>agv_wifi_bridge.bin <InputFile OnChange="e => fileEsp = e.File" /></label>
        }
        <button class="primary" @onclick="Upload" disabled="@busy">@(busy ? "업로드 중…" : "업로드")</button>
        @if (msg is not null) { <div class="msg @(err ? "err" : "")">@msg</div> }
    </div>
</section>

<section class="card">
    <h2>목록</h2>
    <table class="grid">
        <thead><tr><th>종류</th><th>버전</th><th>프로젝트</th><th>파일</th><th>업로드</th><th>메모</th><th></th></tr></thead>
        <tbody>
            @foreach (var e in Store.List())
            {
                <tr>
                    <td>@e.Kind</td><td><b>@e.Version</b></td><td>@e.Project</td>
                    <td class="small">@e.FilesText</td>
                    <td>@e.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@e.Notes</td>
                    <td><button @onclick="() => Delete(e.Id)">삭제</button></td>
                </tr>
            }
        </tbody>
    </table>
</section>

@code {
    string kind = "Dsp", version = "", project = "", notes = "";
    IBrowserFile? fileDsp, fileEsp;
    bool busy, err;
    string? msg;

    async Task Upload()
    {
        busy = true; msg = null; err = false;
        try
        {
            var files = new List<(string, string, Stream)>();
            const long max = 64L * 1024 * 1024;
            if (kind == "Dsp") { if (fileDsp is not null) files.Add(("dspfw", fileDsp.Name, fileDsp.OpenReadStream(max))); }
            else if (fileEsp is not null) files.Add(("esp", fileEsp.Name, fileEsp.OpenReadStream(max)));
            if (files.Count == 0) { msg = "파일을 선택하세요"; err = true; return; }
            var e = await Store.AddAsync(kind == "Dsp" ? FirmwareKind.Dsp : FirmwareKind.Esp, version, project, notes, files);
            foreach (var (_, _, s) in files) s.Dispose();
            msg = $"등록: {e.Kind} {e.Version} — {e.FilesText}";
            fileDsp = fileEsp = null;
        }
        catch (Exception ex) { msg = ex.Message; err = true; }
        finally { busy = false; }
    }

    void Delete(string id)
    {
        if (JobSvc.List().Any(j => j.FirmwareId == id && j.State is JobState.Scheduled or JobState.Running)) { msg = "예약·실행 중인 작업이 쓰는 펌웨어입니다"; err = true; return; }
        Store.Delete(id);
    }
}

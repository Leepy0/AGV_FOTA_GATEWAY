@page "/"
@inject AgvRegistry Reg
@inject BridgeUdpService Link
@inject AgvGroupStore Groups
@inject IOptions<GatewayOptions> Opt
@inject BridgeReleaseService Rel
@inject ICfgChannel Ch
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>호기 현황 · AGV FOTA</PageTitle>
<h1>호기 현황</h1>
<p class="freshness @(Stale ? "stale" : "muted")" role="status">
    @if (all.Count == 0) { <text>호기 신호를 아직 받지 못했습니다</text> }
    else if (Stale) { <text>⚠ 마지막 수신 @Ago(lastSeen) — @(Opt.Value.OfflineAfterSec)초 넘게 어느 호기의 신호도 받지 못했습니다. 서버 UDP @Opt.Value.UdpPort 수신과 네트워크를 확인하세요.</text> }
    else { <text>마지막 수신 @Ago(lastSeen) · 호기 신호 @(Opt.Value.OfflineAfterSec)초 넘게 없으면 오프라인 · 행을 누르면 상세</text> }
</p>

@if (all.Count == 0)
{
    <div class="empty">아직 보이는 호기가 없습니다. 브리지의 <code>server</code> IP 가 이 PC 이고 UDP @Opt.Value.UdpPort 이 열려 있는지 확인하세요 (<a href="settings">설정</a> 에서 이 PC 의 IP 를 볼 수 있습니다).</div>
}
else
{
    @if (conflicts.Count > 0)
    {
        <div class="banner err" role="alert">
            ⚠ <b>호기 번호 충돌</b>
            @foreach (var c in conflicts) { <span class="badge bad" title="충돌 @(c.ConflictCount)회 · 마지막 @Ago(c.ConflictAt)">@c.Id.ToString("D2") 호기 · @c.EndPoint ↔ @c.ConflictEndPoint</span> }
            <br /><span class="small">배포·수동 전송 제외 — 한쪽 브리지의 agv 번호를 고치세요</span>
        </div>
    }
    @if (!relDismissed && Rel.Latest is { } latest && all.Count(a => latest.IsOutdated(a.Status?.Fw)) is var oldN and > 0)
    {
        <div class="banner info row">
            <span class="grow">브리지 새 버전 <b>v@(latest.Version.ToString(3))</b> · 구버전 @oldN 대 → <a href="firmware">펌웨어</a></span>
            <button type="button" @onclick="() => relDismissed = true">닫기</button>
        </div>
    }
    @if (clockBad.Count > 0)
    {
        <div class="banner err" role="alert">
            ⚠ <b>시각 어긋남 @clockBad.Count 대</b> (@Opt.Value.ClockSkewWarnMs ms 초과)
            @foreach (var c in clockBad.Take(10)) { <span class="badge bad">@c.Id.ToString("D2") @ClockText(c)</span> }
            <span class="small">@(Opt.Value.ClockAutoSync ? "자동 보정 중" : "자동 보정 꺼짐 — 호기 상세의 [시각 동기]")</span>
        </div>
    }
    @* 개요(요약 카드, 누르면 거름) → 구역 → 목록 → 행을 눌러 상세 *@
    <div class="kpis">
        <button type="button" class="kpi @(filter == "all" ? "on" : "")" @onclick='() => filter = "all"'><div class="v">@all.Count</div><div class="l">전체 호기</div></button>
        <button type="button" class="kpi @(filter == "on" ? "on" : "")" @onclick='() => filter = "on"'><div class="v">@onlineN<small>/ @all.Count</small></div><div class="l">온라인</div></button>
        <button type="button" class="kpi @(filter == "off" ? "on" : "")" @onclick='() => filter = "off"'><div class="v">@(all.Count - onlineN)</div><div class="l">오프라인</div></button>
        <button type="button" class="kpi @(attnN > 0 ? "attn" : "") @(filter == "attn" ? "on" : "")" @onclick='() => filter = "attn"' title="충돌·OTA 미확정·시각 편차·프레임 손실·RSSI 약함 등 확인이 필요한 온라인 호기"><div class="v">@(attnN > 0 ? "⚠ " : "")@attnN</div><div class="l">점검 필요</div></button>
        @if (busyDsp > 0) { <button type="button" class="kpi attn @(filter == "dsp" ? "on" : "")" @onclick='() => filter = "dsp"'><div class="v">@busyDsp</div><div class="l">메인보드 작업 중</div></button> }
    </div>
    @if (Groups.Count > 0 && Groups.Tree.Children.Count > 0)
    {
        <div class="zones" role="group" aria-label="구역별 요약">
            @foreach (var z in Groups.Tree.Children)
            {
                var zOn = all.Count(a => z.AllAgvs.Contains(a.Id) && On(a));
                var zAttn = all.Count(a => z.AllAgvs.Contains(a.Id) && On(a) && Issues(a).Count > 0);
                <button type="button" class="zone @(group == z.Path ? "on" : "")" aria-pressed="@(group == z.Path ? "true" : "false")" @onclick="() => group = group == z.Path ? string.Empty : z.Path">
                    <b>@z.Name</b><span>온라인 @zOn / @z.Count@(zAttn > 0 ? $" · 점검 {zAttn}" : "")</span>
                </button>
            }
        </div>
    }
    <div class="stats">
        <span class="stat-group">
            <span class="muted small">브리지 fw</span>
            @foreach (var g in all.Where(On).GroupBy(FwKey).OrderByDescending(g => g.Count()))
            {
                <button class="stat @(filter == "fw:" + g.Key ? "on" : "")" @onclick='() => filter = "fw:" + g.Key'>@g.Key <b>×@g.Count()</b></button>
            }
        </span>
        <span class="stat-group">
            <span class="muted small">메인보드</span>
            @foreach (var g in all.Where(On).GroupBy(DspKey).OrderByDescending(g => g.Count()))
            {
                <button class="stat @(filter == "dsp:" + g.Key ? "on" : "")" @onclick='() => filter = "dsp:" + g.Key' title="@(g.Key == "-" ? "브리지가 메인보드 OTA 를 지원하지 않음 (0.5.0 미만)" : g.Key == "?" ? "브리지가 메인보드 앱에서 버전 응답을 못 받음" : "")">@g.Key <b>×@g.Count()</b></button>
            }
        </span>
        @if (Groups.Count > 0)
        {
            <select class="grp" value="@group" @onchange="e => group = e.Value?.ToString() ?? string.Empty" title="구역으로 거르기" aria-label="구역으로 거르기">
                <option value="">구역 전체</option>
                @* 브라우저가 option 앞쪽 ASCII 공백을 지우므로 들여쓰기는 NBSP(U+00A0) + 단계 표시. 마우스를 올리면 전체 경로 *@
                @foreach (var n in Groups.Tree.Descendants()) { <option value="@n.Path" title="@n.Path">@Indent(n.Level)@n.Name (@n.Count)</option> }
            </select>
        }
        <input class="search" @bind="search" @bind:event="oninput" placeholder="검색: 호기·IP·버전·구역" aria-label="호기 검색 (호기·IP·버전·구역)" />
    </div>

    <div class="table-wrap">
        <table class="grid clickable">
            <thead>
                <tr><th>호기</th><th>구역</th><th>상태</th><th>브리지 fw</th><th>메인보드 앱 / 부트</th><th>스테이징</th><th>RSSI</th><th>점검</th></tr>
            </thead>
            <tbody>
                @foreach (var a in Visible())
                {
                    var on = On(a);
                    var st = a.Status;
                    var conflict = a.InConflict(Opt.Value.OfflineAfterSec);
                    <tr class="@(on ? "" : "off") @(sel == a.Id ? "sel" : "")" tabindex="0" aria-expanded="@(sel == a.Id ? "true" : "false")"
                        @onclick="() => Toggle(a.Id)" @onkeydown="e => RowKey(e, a.Id)">
                        <td><b>@a.Id.ToString("D2")</b>@if (conflict) { <span class="badge bad" title="같은 번호 장치: @a.ConflictEndPoint (사용 중 @a.EndPoint)">충돌</span> }</td>
                        <td class="zonecell" title="@(Groups.Get(a.Id)?.Group.Path)">@(Zone(Groups.Get(a.Id)?.Group.Path).main)<small>@(Zone(Groups.Get(a.Id)?.Group.Path).rest)</small></td>
                        <td><span class="dot @(on ? "ok" : "bad")"></span>@(on ? "온라인" : $"오프라인 · {Ago(a.LastSeen)}")</td>
                        <td>@st?.Fw</td>
                        <td title="@(st?.DspState == "nopart" ? "브리지에 dspfw 파티션 없음 — USB 전체 굽기 필요" : st?.DspState == "" ? "브리지 0.5.0 미만" : "")">@(st is null || string.IsNullOrEmpty(st.DspState) ? "-" : $"{(st.HasDsp ? st.Dsp : "?")} / {st.DspBoot}")@(st?.DspState == "programming" ? " ⟳ 프로그래밍" : st?.DspState == "nopart" ? " ⚠ 파티션 없음" : "")</td>
                        <td>@(st?.StagedVer is { Length: > 0 } sv ? $"{sv} (job {st.StagedJob})" : st?.DspState is "downloading" ? "받는 중" : "")</td>
                        <td class="@Rssi(st?.Rssi).cls" title="@Rssi(st?.Rssi).text">@(st is null || st.Rssi == 0 ? "" : st.Rssi)</td>
                        <td>@if (on) { @foreach (var i in Issues(a)) { <span class="badge warn">⚠ @i</span> } }</td>
                    </tr>
                    @if (sel == a.Id)
                    {
                        <tr class="detail"><td colspan="8">
                            <div class="detail-box">
                                <div class="row-buttons">
                                    <b>@a.Id.ToString("D2") 호기</b>
                                    <button @onclick='() => Do(a.Id, Link.SendInfoRequest, "INFO 요청")' @onclick:stopPropagation>INFO 요청</button>
                                    <button @onclick='() => Do(a.Id, Link.SendPing, "PING")' @onclick:stopPropagation>PING</button>
                                    <a href="trace?agv=@a.Id" @onclick:stopPropagation>통신 로그</a>
                                    <a href="jobs?agv=@a.Id" @onclick:stopPropagation>이 호기에 배포</a>
                                    <a href="groups?path=@Uri.EscapeDataString(Groups.Get(a.Id)?.Group.Path ?? "")" @onclick:stopPropagation>구역 @(Groups.Get(a.Id) is null ? "(미등록)" : "")</a>
                                    @if (st?.HasClock == true) { <button @onclick='() => Do(a.Id, Link.SendTime, "시각 동기")' @onclick:stopPropagation title="서버 시각을 브리지에 보냅니다">시각 동기</button> }
                                    @if (result is { } r && r.agv == a.Id) { <span class="msg @(r.ok ? "" : "err")" role="status">@r.text</span> }
                                </div>
                                <div class="row-buttons small">
                                    <span class="muted small">원격 진단</span>
                                    <button @onclick='() => Diag(a.Id, "설정 읽기", "cfg json")' @onclick:stopPropagation disabled="@(diagBusy || !on)">설정 읽기</button>
                                    <button @onclick='() => Diag(a.Id, "상태 읽기", "stat json")' @onclick:stopPropagation disabled="@(diagBusy || !on)">상태 읽기</button>
                                    <button @onclick="() => Scan(a.Id)" @onclick:stopPropagation disabled="@(diagBusy || !on)" title="주변 2.4GHz AP 목록 (브리지 0.7.0+). 2~3초 동안 중계가 느려질 수 있어 AGV 정지 상태에서만">AP 스캔</button>
                                    <button @onclick='() => Diag(a.Id, "서버 ping", "nettest")' @onclick:stopPropagation disabled="@(diagBusy || !on)" title="브리지에서 서버로 ping 3회 (브리지 0.7.0+)">서버 ping</button>
                                    @if (diagBusy && diag is null) { <span class="muted small">기다리는 중…</span> }
                                </div>
                                @if (diag is { } d && d.Agv == a.Id)
                                {
                                    <div class="msg @(d.Error is null ? "" : "err")" role="status">@d.Title @(d.Error is null ? "" : $"— {d.Error}")</div>
                                    @if (d.Scan is { } scan)
                                    {
                                        <table class="grid">
                                            <thead><tr><th>SSID</th><th>RSSI</th><th>채널</th><th>보안</th></tr></thead>
                                            <tbody>@foreach (var s in scan) { <tr><td>@s.Ssid</td><td class="@Rssi(s.Rssi).cls">@s.Rssi</td><td>@s.Ch</td><td>@s.Auth</td></tr> }</tbody>
                                        </table>
                                        @if (scan.Count == 0) { <div class="muted small">보이는 AP 가 없습니다.</div> }
                                    }
                                    else if (d.Text is not null) { <pre class="log small">@d.Text</pre> }
                                }
                                @if (st is not null)
                                {
                                    <dl class="kv">
                                        <dt>마지막 수신</dt><dd>@a.LastSeen.ToLocalTime().ToString("HH:mm:ss") (@Ago(a.LastSeen))</dd>
                                        <dt>가동</dt><dd>@Up(st.UpSeconds)</dd>
                                        <dt>Wi-Fi</dt><dd>ch @st.Channel · @st.Bssid · 끊김 @(st.Disconnects)회 · RSSI @st.Rssi (@Rssi(st.Rssi).text)@(a.LastTag.Length > 0 ? $" · 마지막 태그 {a.LastTag}" : "")</dd>
                                        <dt>브리지</dt><dd>슬롯 @st.Part · ota <span class="@(st.Ota == "pending" ? "warn-text" : "")" title="@(st.Ota == "pending" ? "재부팅 후 미확정 — 서버 PING 을 받으면 valid 로 확정" : "")">@st.Ota</span> · cfg @st.Cfg@(st.SetupAp ? " (AP)" : "")</dd>
                                        <dt>프레임</dt><dd>MAIN ↑@a.MainUp / ↓@a.MainDown · 손실 <span class="@(a.SeqLoss > 0 ? "warn-text" : "")">@a.SeqLoss</span>@(a.LastFrame.Length > 0 ? " · 마지막 " : "") <span class="mono">@a.LastFrame</span></dd>
                                        <dt>시각</dt><dd>@ClockTitle(a)@(a.TimeReplies > 0 ? $" · 서버가 시각 요청에 {a.TimeReplies}회 답함" : "")</dd>
                                        <dt>주소</dt><dd class="mono">@st.Ip @(st.Mac.Length > 0 ? $"({st.Mac})" : "") ← @a.EndPoint</dd>
                                        <dt>UART</dt><dd>MAIN rx @st.MainRx / tx @st.MainTx · RFID rx @st.RfidRx · 오류 @st.UartErrors</dd>
                                        <dt>네트</dt><dd>오프라인 @st.NetOffline · 오류 @st.NetErrors · heap @st.Heap.ToString("N0")</dd>
                                        <dt>메인보드</dt><dd>@(string.IsNullOrEmpty(st.DspState) ? "지원 안 함 (브리지 0.5.0 미만)" : $"앱 {(st.HasDsp ? st.Dsp : "?")} · 부트로더 {st.DspBoot} · 빌드 {st.DspBuild} · 상태 {st.DspState}{(st.DspState == "nopart" ? " — dspfw 파티션 없음, USB 전체 굽기 필요" : "")}")</dd>
                                    </dl>
                                }
                                <pre class="log small">@Pretty(a.StatusRaw)</pre>
                            </div>
                        </td></tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Visible().Count == 0) { <div class="empty">조건에 맞는 호기가 없습니다.</div> }
}

@code {
    IReadOnlyList<AgvState> all = [];
    [SupplyParameterFromQuery] public string? Group { get; set; }
    string filter = "all", search = "", group = "";
    int? sel;
    (int agv, string text, bool ok)? result;   // INFO/PING 결과 — 그 호기 상세에서만 보인다
    int pending, busyDsp, onlineN, attnN;
    DateTime lastSeen;   // 가장 최근에 받은 호기 신호
    bool relDismissed;   // 새 브리지 버전 안내를 이번 화면에서 닫음
    bool Stale => all.Count > 0 && (DateTime.UtcNow - lastSeen).TotalSeconds > Opt.Value.OfflineAfterSec;
    List<AgvState> conflicts = [];
    /// <summary>온라인이면서 시각 동기를 아는 브리지인데 미동기이거나 편차가 임계를 넘은 호기</summary>
    List<AgvState> clockBad = [];
    System.Threading.Timer? timer;

    protected override void OnInitialized()
    {
        Reg.Changed += OnChanged; Groups.Changed += OnChanged; Rel.Changed += OnChanged;
        timer = new System.Threading.Timer(_ => OnChanged(), null, 2000, 2000);   // 오프라인 표시 갱신
        if (!string.IsNullOrEmpty(Group)) group = Group;
        Load();
    }
    void Load()
    {
        all = Reg.Snapshot();
        lastSeen = all.Count == 0 ? default : all.Max(a => a.LastSeen);
        onlineN = all.Count(On);
        pending = all.Count(a => On(a) && a.Status?.Ota == "pending");
        busyDsp = all.Count(a => On(a) && a.Status?.DspState is "downloading" or "programming");
        conflicts = all.Where(a => a.InConflict(Opt.Value.OfflineAfterSec)).ToList();
        clockBad = all.Where(a => On(a) && a.Status is { HasClock: true } st && st.UpSeconds >= 30
                                  && (!st.ClockSynced || (a.ClockSkewMs is { } k && BridgeClock.OverThreshold(k, Opt.Value.ClockSkewWarnMs)))).ToList();
        attnN = all.Count(a => On(a) && Issues(a).Count > 0);
        // 고른 필터의 버튼이 사라졌으면(개수 0, 버전 칩 없어짐) 전체로 되돌린다 — 빈 표만 남지 않게
        bool exists = filter switch
        {
            "all" or "on" or "off" => true,
            "pending" => pending > 0,
            "dsp" => busyDsp > 0,
            "attn" => attnN > 0,
            _ when filter.StartsWith("fw:") => all.Any(a => On(a) && FwKey(a) == filter[3..]),
            _ when filter.StartsWith("dsp:") => all.Any(a => On(a) && DspKey(a) == filter[4..]),
            _ => false,
        };
        if (!exists) filter = "all";
    }
    void OnChanged() => InvokeAsync(() => { Load(); StateHasChanged(); });
    public void Dispose() { Reg.Changed -= OnChanged; Groups.Changed -= OnChanged; Rel.Changed -= OnChanged; timer?.Dispose(); }

    // ───── 시각 ─────
    string ClockText(AgvState a)
    {
        if (a.Status is not { } st) return "";
        if (!st.HasClock) return "-";
        if (!st.ClockSynced || a.ClockSkewMs is null) return "미동기";
        return BridgeClock.FormatSkew(a.ClockSkewMs.Value);
    }
    string ClockTitle(AgvState a)
    {
        if (a.Status is not { } st) return "";
        if (!st.HasClock) return "시각 동기를 지원하지 않는 브리지 (0.8.0 미만)";
        if (!st.ClockSynced) return "브리지 시각이 아직 서버와 맞춰지지 않음";
        return $"브리지 − 서버 = {BridgeClock.FormatSkew(a.ClockSkewMs ?? 0)} (한 방향 지연 수 ms 포함) · 마지막 동기 {st.TsyncAgeSec}초 전 · 임계 {Opt.Value.ClockSkewWarnMs} ms";
    }

    // ───── 원격 진단 (CFG_CMD 를 보내고 응답을 기다린다) ─────
    sealed record ScanRow(string Ssid, int Rssi, int Ch, string Auth);
    sealed record DiagResult(int Agv, string Title, string? Text, string? Error, List<ScanRow>? Scan);
    DiagResult? diag;
    bool diagBusy;

    async Task Scan(int agv)
    {
        // 스캔은 STA 연결 중 중계를 2~3초 느리게 한다 — 정지 확인 뒤에만
        if (!await JS.ConfirmAsync($"{agv:D2} 호기 AP 스캔\n⚠ AGV 정지 상태에서만 — 2~3초 동안 중계가 느려집니다", "AP 스캔")) return;
        await Diag(agv, "AP 스캔", "scan");
    }

    async Task Diag(int agv, string title, string cmd)
    {
        diagBusy = true; diag = null; StateHasChanged();
        try
        {
            var r = await Ch.RequestCfgAsync(agv, cmd, TimeSpan.FromSeconds(20));
            if (!r.Ok) { diag = new(agv, title, null, r.Error, null); return; }
            var text = r.Text!.Trim();
            if (cmd == "scan" && ParseScan(text) is { } rows) { diag = new(agv, $"{title} — {rows.Count}개", null, null, rows); return; }
            diag = new(agv, title, Pretty(text), text.StartsWith("unknown command", StringComparison.Ordinal) ? "이 브리지 펌웨어가 지원하지 않는 명령입니다" : null, null);
        }
        finally { diagBusy = false; StateHasChanged(); }
    }

    static List<ScanRow>? ParseScan(string text)
    {
        if (!text.StartsWith('[')) return null;
        try
        {
            using var d = System.Text.Json.JsonDocument.Parse(text);
            return d.RootElement.EnumerateArray().Select(e => new ScanRow(
                e.TryGetProperty("ssid", out var s) ? s.GetString() ?? "" : "", e.TryGetProperty("rssi", out var r) ? r.GetInt32() : 0,
                e.TryGetProperty("ch", out var c) ? c.GetInt32() : 0, e.TryGetProperty("auth", out var a) ? a.GetString() ?? "" : "")).ToList();
        }
        catch (Exception e) when (e is System.Text.Json.JsonException or InvalidOperationException or FormatException) { return null; }
    }

    bool On(AgvState a) => a.Online(Opt.Value.OfflineAfterSec);
    /// <summary>구역 경로를 두 줄로: 위는 끝 두 단계(공정 · 라우트), 아래는 나머지 상위 경로</summary>
    static (string main, string rest) Zone(string? path)
    {
        if (string.IsNullOrEmpty(path)) return ("", "");
        var p = path.Split(" / ");
        return p.Length <= 2 ? (string.Join(" · ", p), "") : (string.Join(" · ", p[^2..]), string.Join(" / ", p[..^2]));
    }

    /// <summary>온라인 호기에서 운용자가 볼 만한 이상 징후 (목록 '점검' 열·요약 카드 공통). 색이 아니라 글자로 알린다</summary>
    List<string> Issues(AgvState a)
    {
        var l = new List<string>();
        if (a.InConflict(Opt.Value.OfflineAfterSec)) l.Add("번호 충돌");
        if (a.Status?.Ota == "pending") l.Add("OTA 미확정");
        if (a.Status?.DspState == "nopart") l.Add("파티션 없음");
        else if (a.Status is { HasDsp: false } m && !string.IsNullOrEmpty(m.DspState)) l.Add("앱 버전 모름");
        if (clockBad.Contains(a)) l.Add("시각 편차");
        if (a.SeqLoss > 0) l.Add($"손실 {a.SeqLoss}");
        if (a.Status is { Rssi: < 0 } s && s.Rssi < -80) l.Add("RSSI 약함");
        return l;
    }

    List<AgvState> Visible()
    {
        IEnumerable<AgvState> q = all;
        q = filter switch
        {
            "on" => q.Where(On), "off" => q.Where(a => !On(a)),
            // 버튼·칩의 개수는 온라인 호기만 세므로 거를 때도 온라인만
            "pending" => q.Where(a => On(a) && a.Status?.Ota == "pending"),
            "dsp" => q.Where(a => On(a) && a.Status?.DspState is "downloading" or "programming"),
            "attn" => q.Where(a => On(a) && Issues(a).Count > 0),
            _ when filter.StartsWith("fw:") => q.Where(a => On(a) && FwKey(a) == filter[3..]),
            _ when filter.StartsWith("dsp:") => q.Where(a => On(a) && DspKey(a) == filter[4..]),
            _ => q,
        };
        if (!string.IsNullOrEmpty(group))
        {
            var ids = Groups.AgvsUnder(group).ToHashSet();
            q = q.Where(a => ids.Contains(a.Id));
        }
        if (!string.IsNullOrWhiteSpace(search))
        {
            var s = search.Trim();
            q = q.Where(a => a.Id.ToString("D2").Contains(s) || (a.EndPoint?.Address.ToString().Contains(s) ?? false)
                          || (a.Status?.Fw.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) || (a.Status?.Dsp.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                          || (a.Status?.Cfg.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                          || (Groups.Get(a.Id)?.Group.Path.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return q.ToList();
    }

    static string FwKey(AgvState a) => a.Status?.Fw is { Length: > 0 } f ? f : "?";
    static string DspKey(AgvState a) => a.Status is { } s && !string.IsNullOrEmpty(s.DspState) ? (s.HasDsp ? s.Dsp : "?") : "-";
    static string Indent(int level) => level <= 0 ? "" : new string('\u00A0', level * 3) + "└ ";

    void Toggle(int id) => sel = sel == id ? null : id;
    void RowKey(KeyboardEventArgs e, int id) { if (e.Key == "Enter") Toggle(id); }

    void Do(int agv, Func<int, bool> f, string what)
    {
        var ok = f(agv);
        result = (agv, ok ? $"{what} 전송" : $"{what} 실패 (호기 주소 없음)", ok);
    }

    static string Ago(DateTime utc)
    {
        var s = (DateTime.UtcNow - utc).TotalSeconds;
        return s < 60 ? $"{(int)s}초 전" : s < 3600 ? $"{(int)(s / 60)}분 전" : s < 86400 ? $"{(int)(s / 3600)}시간 전" : $"{(int)(s / 86400)}일 전";
    }
    static string Up(long sec) => sec < 3600 ? $"{sec / 60}분" : sec < 86400 ? $"{sec / 3600}시간 {sec % 3600 / 60}분" : $"{sec / 86400}일 {sec % 86400 / 3600}시간";
    static (string cls, string text) Rssi(int? r) => r is null or 0 ? ("", "") : r >= -60 ? ("", "좋음") : r >= -70 ? ("", "보통") : r >= -80 ? ("warn-text", "약함") : ("bad-text", "매우 약함 — AP 위치 확인");
    static string Pretty(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "(heartbeat 없음)";
        try { using var d = System.Text.Json.JsonDocument.Parse(raw); return System.Text.Json.JsonSerializer.Serialize(d, new System.Text.Json.JsonSerializerOptions { WriteIndented = true }); }
        catch (System.Text.Json.JsonException) { return raw; }
    }
}

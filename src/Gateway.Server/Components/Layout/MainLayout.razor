@inherits LayoutComponentBase
@inject AgvRegistry Reg
@inject AcsRelayService Acs
@inject AcsPositionPushService AcsApi
@inject IOptions<GatewayOptions> Opt
@inject UpdateService Upd
@implements IDisposable

<div class="shell">
    <nav class="side">
        <div class="brand">AGV FOTA<br /><small>Gateway</small></div>
        <NavLink href="" Match="NavLinkMatch.All">호기 현황</NavLink>
        <NavLink href="firmware">펌웨어</NavLink>
        <NavLink href="jobs">배포 작업</NavLink>
        <NavLink href="trace">통신 로그</NavLink>
        <NavLink href="update">서버 업데이트 @(Upd.Stage is UpdateStage.Available or UpdateStage.Ready ? "●" : "")</NavLink>
        <div class="foot">
            <div>호기 @online / @total 온라인</div>
            <div>ACS 중계 @(Acs.Enabled ? (Acs.Connected ? "연결" : "끊김") : "사용 안 함")</div>
            <div>ACS 위치 API @(AcsApi.Enabled ? (AcsApi.LogOnly ? "로그만" : AcsApi.FailStreak > 0 ? "오류" : "발행 중") : "사용 안 함")</div>
            <div>UDP :@Opt.Value.UdpPort</div>
            <div>v@(Upd.CurrentText)</div>
        </div>
    </nav>
    <main class="content">@Body</main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    오류가 발생했습니다. <a href="." class="reload">새로 고침</a> <span class="dismiss">🗙</span>
</div>

@code {
    int online, total;
    protected override void OnInitialized() { Reg.Changed += OnChanged; Upd.Changed += OnChanged; Refresh(); }
    void Refresh() { var s = Reg.Snapshot(); total = s.Count; online = s.Count(a => a.Online(Opt.Value.OfflineAfterSec)); }
    void OnChanged() => InvokeAsync(() => { Refresh(); StateHasChanged(); });
    public void Dispose() { Reg.Changed -= OnChanged; Upd.Changed -= OnChanged; }
}

@inherits LayoutComponentBase
@inject AgvRegistry Reg
@inject AcsRelayService Acs
@inject AcsPositionPushService AcsApi
@inject BridgeUdpService Link
@inject JobService Jobs
@inject IOptions<GatewayOptions> Opt
@inject UpdateService Upd
@inject NavigationManager Nav
@implements IDisposable

<div class="shell">
    @* 좁은 화면: 위에는 이름·온라인 수만, 메뉴는 아래 탭(자주 쓰는 3개 + 더보기) *@
    <header class="topbar"><b>AGV FOTA</b> <span class="muted"><span class="dot @(online > 0 ? "ok" : total > 0 ? "bad" : "")"></span>호기 @online / @total 온라인</span></header>
    <nav class="side" aria-label="주 메뉴">
        <div class="brand"><span class="logo">▲</span><div><b>AGV FOTA</b><small>Gateway</small></div></div>
        <NavLink href="" Match="NavLinkMatch.All"><span class="ic">◉</span>호기 현황<span class="nav-badge">@online/@total</span></NavLink>
        <NavLink href="groups"><span class="ic">▦</span>구역</NavLink>
        <NavLink href="acs-agvs"><span class="ic">⇄</span>ACS AGV 연결</NavLink>
        <div class="grp">배포</div>
        <NavLink href="firmware"><span class="ic">▣</span>펌웨어</NavLink>
        <NavLink href="jobs"><span class="ic">↻</span>배포 작업 @if (awaiting > 0) { <span class="nav-badge warn" title="스테이징을 마치고 승인을 기다리는 작업">@awaiting</span> } else if (running > 0) { <span class="nav-badge">진행 @running</span> } else if (scheduled > 0) { <span class="nav-badge">예약 @scheduled</span> }</NavLink>
        <div class="grp">진단</div>
        <NavLink href="config"><span class="ic">⚙</span>호기 설정</NavLink>
        <NavLink href="wifi"><span class="ic">◌</span>Wi-Fi 분석</NavLink>
        <NavLink href="trace"><span class="ic">≡</span>통신 로그</NavLink>
        <div class="grp">시스템</div>
        <NavLink href="update"><span class="ic">⬆</span>서버 업데이트 @(Upd.Stage is UpdateStage.Available or UpdateStage.Ready ? "●" : "")</NavLink>
        <NavLink href="settings"><span class="ic">☰</span>설정</NavLink>
        <div class="foot">
            <div><span class="dot @(online > 0 ? "ok" : total > 0 ? "bad" : "")"></span>호기 @online / @total 온라인</div>
            <div>ACS 중계 @(Acs.Enabled ? (Acs.Connected ? "연결" : "끊김") : "사용 안 함")</div>
            <div>ACS 위치 API @(AcsApi.Enabled ? (AcsApi.LogOnly ? "로그만" : AcsApi.FailStreak > 0 ? "오류" : "발행 중") : "사용 안 함")</div>
            <div>UDP :@Opt.Value.UdpPort @(Link.BindError is null ? "" : "⚠")</div>
            <div title="@Upd.ChannelName @Upd.Commit">v@(Upd.CurrentText) · @Upd.ChannelName</div>
            <button type="button" class="theme-btn" onclick="gwTheme()" title="라이트/다크 전환">화면 밝기 전환</button>
        </div>
    </nav>
    <nav class="tabbar" aria-label="하단 메뉴">
        <NavLink href="" Match="NavLinkMatch.All">호기 현황</NavLink>
        <NavLink href="jobs">배포 작업 @if (awaiting > 0) { <span class="nav-badge warn">@awaiting</span> }</NavLink>
        <NavLink href="firmware">펌웨어</NavLink>
        <button type="button" class="tab @(more ? "on" : "")" aria-expanded="@(more ? "true" : "false")" @onclick="() => more = !more">더보기@(Upd.Stage is UpdateStage.Available or UpdateStage.Ready ? " ●" : "")</button>
    </nav>
    @if (more)
    {
        <div class="sheet-bg" @onclick="() => more = false"></div>
        <div class="sheet" role="dialog" aria-label="더보기">
            <NavLink href="groups">구역</NavLink>
            <NavLink href="acs-agvs">ACS AGV 연결</NavLink>
            <NavLink href="config">호기 설정</NavLink>
            <NavLink href="wifi">Wi-Fi 분석</NavLink>
            <NavLink href="trace">통신 로그</NavLink>
            <NavLink href="update">서버 업데이트 @(Upd.Stage is UpdateStage.Available or UpdateStage.Ready ? "●" : "")</NavLink>
            <NavLink href="settings">설정</NavLink>
            <button type="button" onclick="gwTheme()">화면 밝기 전환</button>
        </div>
    }
    <main class="content">
        @if (Link.BindError is { } be)
        {
            <div class="banner err">⚠ <b>@be</b> — 10초마다 다시 시도합니다</div>
        }
        @if (Upd.Stage == UpdateStage.Ready)
        {
            <div class="banner info">서버 <b>@(Upd.Latest?.Tag)</b> 준비됨 → <a href="update">서버 업데이트</a></div>
        }
        @* 화면 처리기에서 예외가 나도 회로가 끊기지 않게 — 오류를 보여 주고, 다른 화면으로 가거나 '다시 시도'로 복구 *@
        <ErrorBoundary @ref="boundary">
            <ChildContent>@Body</ChildContent>
            <ErrorContent Context="ex">
                <div class="error-box" role="alert">화면 처리 중 오류가 났습니다: @ex.Message <button @onclick="Recover">다시 시도</button></div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    화면 연결에 오류가 났습니다. <a href="." class="reload">새로 고침</a> <span class="dismiss">🗙</span>
</div>

@code {
    int online, total, running, scheduled, awaiting;
    bool more;   // 좁은 화면의 '더보기' 시트
    ErrorBoundary? boundary;
    void OnNav(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(() => { more = false; StateHasChanged(); });
    protected override void OnParametersSet() => boundary?.Recover();   // 화면을 옮기면 오류 표시를 거둔다
    void Recover() => boundary?.Recover();
    protected override void OnInitialized() { Nav.LocationChanged += OnNav; Reg.Changed += OnChanged; Upd.Changed += OnChanged; Jobs.Changed += OnChanged; Refresh(); }
    void Refresh()
    {
        var s = Reg.Snapshot(); total = s.Count; online = s.Count(a => a.Online(Opt.Value.OfflineAfterSec));
        var j = Jobs.List(); running = j.Count(x => x.State == JobState.Running); scheduled = j.Count(x => x.State == JobState.Scheduled);
        awaiting = j.Count(x => x.State == JobState.AwaitingApproval && x.ApprovedAt is null);
    }
    void OnChanged() => InvokeAsync(() => { Refresh(); StateHasChanged(); });
    public void Dispose() { Nav.LocationChanged -= OnNav; Reg.Changed -= OnChanged; Upd.Changed -= OnChanged; Jobs.Changed -= OnChanged; }
}

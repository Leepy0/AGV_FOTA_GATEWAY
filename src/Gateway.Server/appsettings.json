{
  "Urls": "http://0.0.0.0:8080",
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "UdpPort": 50000,
    "RfidPort": 50001,
    "DataDir": "data",
    "OfflineAfterSec": 5,
    "PublicBaseUrl": "",
    "Acs": {
      "Enabled": false,
      "Mode": "Client",
      "Host": "127.0.0.1",
      "Port": 6000,
      "ReconnectSec": 3
    }
  },
  "AcsApi": {
    "Enabled": false,
    "LogOnly": true,
    "BaseUrl": "http://127.0.0.1:8000",
    "Path": "/api/agv/positions",
    "Method": "POST",
    "AuthType": "None",
    "AuthValue": "",
    "ApiKeyHeader": "X-API-Key",
    "TimeoutMs": 5000,
    "IntervalMs": 1000,
    "OnlyChanged": true,
    "PerAgv": false,
    "MaxBackoffSec": 60
  },
  "Update": {
    "Enabled": true,
    "BaseUrl": "https://github.com/Leepy0/AGV_FOTA_GATEWAY",
    "ManifestUrl": "",
    "GitHubToken": "",
    "FirstCheckDelaySec": 3,
    "CheckIntervalMin": 360,
    "AutoApply": false,
    "ServiceName": "AgvFotaGateway"
  }
}
